#!/usr/bin/env bash
# post-push: trigger VPS post-push smoke after a successful git push.
# Args supplied by git: $1 = name of the remote, $2 = URL of the remote.
# Writes a marker file (timestamp + SHA) so the 5-min cron can also see fresh
# activity. Also runs the smoke script in the foreground with a 120s timeout
# and writes its output to post-push-smoke.hook.log.
set -uo pipefail
LOG=/home/ubuntu/.hermes/logs/post-push-smoke.hook.log
MARKER=/home/ubuntu/.hermes/logs/post-push-smoke.marker
HEAD_SHA=$(git rev-parse HEAD 2>/dev/null || echo unknown)
mkdir -p "$(dirname "$LOG")" "$(dirname "$MARKER")"
{
  echo "===== post-push trigger $(date -u +%Y-%m-%dT%H:%M:%SZ) head=$HEAD_SHA remote=${1:-?} ====="
} >> "$MARKER"
echo "$HEAD_SHA" >> "$MARKER"
# Synchronous invocation with timeout. The cron also runs this script, so a
# synchronous fire here gives the user near-real-time feedback after a push.
timeout 180 bash /home/ubuntu/.hermes/scripts/post_push_smoke.sh >> "$LOG" 2>&1
echo "===== exit=$? =====" >> "$LOG"
exit 0