#!/usr/bin/env bash
# post-push: trigger VPS post-push smoke after a successful git push.
# Runs detached from the gateway process tree (system cron actually fires it).
# This hook is a thin local trigger: it appends the latest local HEAD SHA to
# the smoke marker file and lets the cron-driven script do the actual check.
#
# Args supplied by git: $1 = name of the remote, $2 = URL of the remote.
set -euo pipefail
HEAD_SHA=$(git rev-parse HEAD)
MARKER=/home/ubuntu/.hermes/logs/post-push-smoke.marker
mkdir -p "$(dirname "$MARKER")"
date -u +"%Y-%m-%dT%H:%M:%SZ" > "$MARKER"
echo "$HEAD_SHA" >> "$MARKER"
# Detached re-run of the smoke script so the user sees fresh result sooner
# than the next 5-minute cron boundary.
nohup bash /home/ubuntu/.hermes/scripts/post_push_smoke.sh \
  >> /home/ubuntu/.hermes/logs/post-push-smoke.hook.log 2>&1 &
disown || true
exit 0