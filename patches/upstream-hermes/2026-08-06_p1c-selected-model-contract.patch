@@ -0,0 +1,69 @@
+"""Tests for T03 (validate_selected_route) and T04 (B4 picker hint gate)."""
+
+import pytest
+from unittest.mock import patch
+
+from hermes_cli.models import (
+    SelectedRouteValidationError,
+    validate_selected_route,
+    curated_models,
+    D8_OPENCODE_ZEN_FREE_MODELS,
+)
+
+
+# ---------------------------------------------------------------------------
+# T03: validate_selected_route
+# ---------------------------------------------------------------------------
+
+class TestValidateSelectedRoute:
+    """Fail-closed curated-list gate."""
+
+    def test_opencode_zen_valid_model_passes(self):
+        """Model in curated list should not raise."""
+        validate_selected_route("opencode-zen", "deepseek-v4-flash-free")
+
+    def test_opencode_zen_all_curated_models_pass(self):
+        """All models in D8_OPENCODE_ZEN_FREE_MODELS should pass."""
+        for model in D8_OPENCODE_ZEN_FREE_MODELS:
+            validate_selected_route("opencode-zen", model)
+
+    def test_opencode_zen_invalid_model_raises(self):
+        """Model NOT in curated list should raise."""
+        with pytest.raises(SelectedRouteValidationError, match="not available"):
+            validate_selected_route("opencode-zen", "gpt-5.4")
+
+    def test_opencode_zen_invalid_model_lists_available(self):
+        """Error message should list available models."""
+        with pytest.raises(SelectedRouteValidationError) as exc_info:
+            validate_selected_route("opencode-zen", "fake-model")
+        msg = str(exc_info.value)
+        assert "deepseek-v4-flash-free" in msg
+        assert "big-pickle" in msg
+
+    def test_custom_provider_always_passes(self):
+        """custom:* providers are always allowed (user-defined)."""
+        validate_selected_route("custom:ftf", "any-model")
+        validate_selected_route("custom:my-ollama", "llama3")
+
+    def test_no_curated_list_allows_any_model(self):
+        """Providers without curated lists allow any model (validated later by live probe)."""
+        # ftf has no curated list
+        validate_selected_route("ftf", "any-model")
+        # opencode-go has no curated list
+        validate_selected_route("opencode-go", "deepseek-v4-pro")
+
+    def test_exception_is_selected_route_validation_error(self):
+        """Wrong model raises SelectedRouteValidationError, not generic Exception."""
+        with pytest.raises(SelectedRouteValidationError):
+            validate_selected_route("opencode-zen", "claude-sonnet-4")
+
+    def test_curated_models_returns_list(self):
+        """curated_models returns a list for providers with curated lists."""
+        result = curated_models("opencode-zen")
+        assert isinstance(result, list)
+        assert "deepseek-v4-flash-free" in result
+
+    def test_curated_models_empty_for_unknown(self):
+        """curated_models returns empty list for unknown providers."""
+        result = curated_models("nonexistent-provider")
+        assert result == []
