+def curated_models(provider: str) -> list[str]:
+    """Return the curated model list for a provider.
+
+    This is the public single accessor for "which model IDs is the user
+    permitted to select under this provider?" (S5 fix). It is the source
+    of authority; the live ``/v1/models`` response only informs
+    availability messaging (e.g. rate-limit warnings), not selectability.
+    """
+    if provider == "opencode-zen":
+        return list(D8_OPENCODE_ZEN_FREE_MODELS)
+    return list(_PROVIDER_MODELS.get(provider, []))
+
+
+class SelectedRouteValidationError(Exception):
+    """Raised when a provider+model combo fails curated-list validation.
+
+    This is a fail-closed gate: if the route is not in a known curated
+    list, the switch is rejected before any config write occurs.
+    """
+
+
+def validate_selected_route(provider: str, model: str) -> None:
+    """Validate that a provider+model combo is in the curated list.
+
+    Fail-closed: if the provider has a curated list, the model MUST be in
+    it. If no curated list exists, the model is allowed (will be validated
+    later by the live API probe in validate_requested_model).
+
+    Custom providers (custom:*) are always allowed — they are user-defined
+    and validated at call time.
+
+    Args:
+        provider: The provider slug (e.g. "opencode-zen", "custom:ftf").
+        model: The model ID to validate.
+
+    Raises:
+        SelectedRouteValidationError: If the model is not in the curated
+            list for the given provider.
+    """
+    # Custom providers are always allowed
+    if provider.startswith("custom:"):
+        return
+    # No curated list = no restriction (validated later by live probe)
+    curated = curated_models(provider)
+    if not curated:
+        return
+    # Model must be in the curated list
+    if model not in curated:
+        raise SelectedRouteValidationError(
+            f"Model `{model}` is not available under provider `{provider}`. "
+            f"Available models: {', '.join(f'`{m}`' for m in curated)}"
+        )
+
+
