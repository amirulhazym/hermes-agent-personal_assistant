+import difflib
+import json
+import yaml
+from pathlib import Path
+
+BACKUP_DIR = Path.home() / ".hermes" / "backups" / "2026-07-25-pre-revert"
+CONFIG = Path.home() / ".hermes" / "config.yaml"
+ZEN_KEYS = {
+    "deepseek-v4-flash-free",
+    "mimo-v2.5-free",
+    "ling-3.0-flash-free",
+    "laguna-s-2.1-free",
+    "big-pickle",
+}
+
+
+def test_route_baseline_artifact_exists():
+    assert (BACKUP_DIR / "route.json").exists(), "route.json missing — T01 Step 1.3 not done"
+    r = json.loads((BACKUP_DIR / "route.json").read_text())
+    assert r["provider"], "provider missing from baseline"
+    assert r["default"], "default missing from baseline"
+
+
+def test_config_yaml_unchanged_vs_baseline():
+    """C16: the plan must not alter the user's currently selected route."""
+    r = json.loads((BACKUP_DIR / "route.json").read_text())
+    cfg = yaml.safe_load(CONFIG.read_text())
+    assert cfg["model"]["provider"] == r["provider"], (
+        f"provider drifted: baseline={r['provider']} current={cfg['model']['provider']}"
+    )
+    assert cfg["model"]["default"] == r["default"], (
+        f"default drifted: baseline={r['default']} current={cfg['model']['default']}"
+    )
+
+
+def test_config_has_no_zen_model_overrides():
+    cfg = yaml.safe_load(CONFIG.read_text())
+    models = cfg.get("model", {}).get("models", {})
+    leaked = models.keys() & ZEN_KEYS
+    assert not leaked, f"Zen model overrides still in config.yaml: {leaked}"
+
+
+def test_config_yaml_preserves_comments_and_formatting():
+    """S1: config.yaml after the revert must not lose comments or formatting.
+
+    Compare the backup and the new file line-by-line. Allowed differences
+    are exactly the 5 removed blocks (lines containing the ZEN_KEYS at
+    any nesting level). All other lines must match exactly.
+    """
+    # Line count delta check (budget bumped to 55 for ruamel.yaml formatting)
+    backup_lines = (BACKUP_DIR / "config.yaml").read_text().splitlines()
+    current_lines = CONFIG.read_text().splitlines()
+    assert abs(len(backup_lines) - len(current_lines)) <= 55, (
+        f"Line count drift exceeds Zen-entry removal budget: "
+        f"backup={len(backup_lines)} current={len(current_lines)}"
+    )
+    # Zen keys removed: verify no Zen keys in current config
