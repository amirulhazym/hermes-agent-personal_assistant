+def test_antigravity_usage_fetches_and_parses_live_quota(monkeypatch):
+    fake_catalog = {
+        "models": {
+            "gemini-3.7-flash-tiered": {
+                "quotaInfo": {
+                    "remainingFraction": 0.95,
+                    "resetTime": "2026-08-25T12:00:00Z",
+                }
+            },
+            "claude-opus-4-6-thinking": {
+                "quotaInfo": {
+                    "remainingFraction": 1.0,
+                    "resetTime": "2026-08-25T14:00:00Z",
+                }
+            }
+        }
+    }
+    monkeypatch.setattr(
+        account_usage,
+        "_fetch_antigravity_catalog",
+        lambda: fake_catalog,
+    )
+    snapshot = account_usage.fetch_account_usage("antigravity")
+    assert snapshot is not None
+    assert snapshot.provider == "antigravity"
+    assert snapshot.title == "Antigravity Quota"
+    assert len(snapshot.windows) == 2
+    assert snapshot.windows[0].label == "gemini-3.7-flash"
+    assert snapshot.windows[0].used_percent == 5.0
+    assert "95.0% remaining" in (snapshot.windows[0].detail or "")
