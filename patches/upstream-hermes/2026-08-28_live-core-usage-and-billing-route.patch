     )
 
 
+def _fetch_antigravity_catalog() -> Optional[dict]:
+    try:
+        import sys
+        from pathlib import Path
+        src = Path.home() / ".hermes" / "plugins" / "antigravity-provider" / "src"
+        if src.exists() and str(src) not in sys.path:
+            sys.path.insert(0, str(src))
+        from antigravity_provider.runtime import fetch_available_models  # type: ignore[import-untyped]
+        return fetch_available_models()
+    except Exception:
+        return None
+
+
+
+def _fetch_antigravity_account_usage() -> Optional[AccountUsageSnapshot]:
+    catalog = _fetch_antigravity_catalog()
+    if not catalog or not isinstance(catalog, dict):
+        return None
+    raw_models = catalog.get("models") or {}
+    if not isinstance(raw_models, dict):
+        return None
+
+    target_pairs = [
+        ("gemini-3.7-flash", ("gemini-3.7-flash-tiered", "gemini-3.7-flash")),
+        ("gemini-3.6-flash", ("gemini-3.6-flash-tiered", "gemini-3.6-flash-high", "gemini-3.6-flash")),
+        ("gemini-3.1-pro", ("gemini-3.1-pro-high", "gemini-pro-agent", "gemini-3.1-pro")),
+        ("gemini-3.5-flash", ("gemini-3-flash-agent", "gemini-3.5-flash-low", "gemini-3.5-flash")),
+        ("claude-sonnet-4-6", ("claude-sonnet-4-6",)),
+        ("claude-opus-4-6", ("claude-opus-4-6-thinking", "claude-opus-4-6")),
+        ("gpt-oss-120b", ("openai/gpt-oss-120b-maas", "gpt-oss-120b-medium", "gpt-oss-120b")),
+    ]
+
+    windows: list[AccountUsageWindow] = []
+    seen_labels: set[str] = set()
+
+    for label, wire_keys in target_pairs:
+        found_info: dict | None = None
+        for key in wire_keys:
+            if key in raw_models and isinstance(raw_models[key], dict):
+                found_info = raw_models[key]
+                break
+        if not found_info:
+            continue
+        q = found_info.get("quotaInfo")
+        if not isinstance(q, dict):
+            continue
+        rem = q.get("remainingFraction")
+        reset = _parse_dt(q.get("resetTime"))
+        if isinstance(rem, (int, float)):
+            used_pct = round((1.0 - rem) * 100, 1)
+            detail = f"{rem * 100:.1f}% remaining"
+            windows.append(
+                AccountUsageWindow(
+                    label=label,
+                    used_percent=used_pct,
+                    reset_at=reset,
+                    detail=detail,
+                )
+            )
+            seen_labels.add(label)
+
+    if not windows:
+        return None
+
+    return AccountUsageSnapshot(
+        provider="antigravity",
+        source="cloudcode_api",
+        fetched_at=_utc_now(),
+        title="Antigravity Quota",
+        plan="Google AI Pro (Subscription)",
+        windows=tuple(windows),
+    )
+
+
 def fetch_account_usage(
