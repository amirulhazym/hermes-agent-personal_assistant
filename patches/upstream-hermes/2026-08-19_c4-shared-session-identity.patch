+        visited.add(cur)
+        try:
+            session = db.get_session(cur)
+        except Exception as e:
+            logging.debug("Error resolving ownership parent for %s: %s", cur, e, exc_info=True)
+            break
+        if not session or not session.get("parent_session_id"):
+            break
+        cur = session["parent_session_id"]
+    return cur
 
 
