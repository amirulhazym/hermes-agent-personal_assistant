+        self, tmp_path, platform
+    ):
+        from hermes_state import SessionDB
+
+        db = SessionDB(db_path=tmp_path / f"{platform.value}.db")
+        lane_key = f"agent:main:{platform.value}:dm:67890"
+        for sid, title, started_at in (
+            ("lane_old", "Lane Older", 100.0),
+            ("lane_new", "Lane Newer", 200.0),
