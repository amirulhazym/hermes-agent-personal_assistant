+class TestSecondaryProfileHandler:
+    """Secondary adapters must not dispatch through a missing profile."""
+
+    @pytest.mark.asyncio
+    async def test_missing_profile_drops_before_message_dispatch(
+        self, mock_runner, discord_source
+    ):
+        discord_source.profile = None
+        event = MessageEvent(text="must not reach provider", source=discord_source)
+        mock_runner._handle_message = AsyncMock(return_value="wrong-profile-response")
+
+        with patch(
+            "hermes_cli.profiles.get_profile_dir",
+            return_value=Path("/hermes/profiles/nonexistent"),
+        ), patch("hermes_cli.profiles.profile_exists", return_value=False), patch(
+            "hermes_constants.get_hermes_home", return_value=Path("/hermes")
+        ):
+            handler = mock_runner._make_profile_message_handler("nonexistent")
+            result = await handler(event)
+
+        assert result is None
+        assert event.source.profile == "nonexistent"
+        assert event.source.profile_route_rejected is True
+        mock_runner._handle_message.assert_not_awaited()
+
+
+class TestDefaultProfileHandler:
+    """Primary multiplex ingress must reject stale explicit profiles."""
+
+    @pytest.mark.asyncio
+    async def test_explicit_missing_profile_drops_before_message_dispatch(
+        self, mock_runner, discord_source
+    ):
+        discord_source.profile = "nonexistent"
+        event = MessageEvent(text="must not reach provider", source=discord_source)
+        mock_runner._handle_message = AsyncMock(return_value="wrong-profile-response")
+
+        with patch(
+            "hermes_cli.profiles.get_profile_dir",
+            return_value=Path("/hermes/profiles/nonexistent"),
+        ), patch("hermes_cli.profiles.profile_exists", return_value=False):
+            handler = mock_runner._make_default_profile_message_handler()
+            result = await handler(event)
+
+        assert result is None
+        assert event.source.profile == "nonexistent"
+        assert event.source.profile_route_rejected is True
+        mock_runner._handle_message.assert_not_awaited()
+
