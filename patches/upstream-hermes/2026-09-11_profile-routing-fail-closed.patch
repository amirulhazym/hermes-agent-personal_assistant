+class TestServedProfileEnumeration:
+    """The gateway allowlist must be the served-profile chokepoint."""
+
+    def test_allowlist_serves_bot_2_and_skips_absent_ovis2(
+        self, tmp_path, monkeypatch, caplog
+    ):
+        import hermes_cli.profiles as profiles
+
+        default_home = tmp_path / "default"
+        profiles_root = tmp_path / "profiles"
+        bot_2_home = profiles_root / "bot_2"
+        default_home.mkdir()
+        bot_2_home.mkdir(parents=True)
+
+        monkeypatch.setattr(profiles, "_get_default_hermes_home", lambda: default_home)
+        monkeypatch.setattr(profiles, "_get_profiles_root", lambda: profiles_root)
+        monkeypatch.setattr(profiles, "get_active_profile_name", lambda: "default")
+        monkeypatch.setattr(profiles, "_WARNED_MISSING_ALLOWLIST_ENTRIES", set())
+
+        with caplog.at_level(logging.WARNING, logger="hermes_cli.profiles"):
+            served = profiles.profiles_to_serve(
+                multiplex=True,
+                profile_allowlist=["bot_2", "ovis2"],
+            )
+
+        assert served == [("default", default_home), ("bot_2", bot_2_home)]
+        assert "ovis2" in caplog.text
+        assert "Skipping missing" in caplog.text
+
