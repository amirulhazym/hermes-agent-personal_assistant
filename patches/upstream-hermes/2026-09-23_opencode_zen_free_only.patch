diff --git a/tests/hermes_cli/test_opencode_zen_free_only_20260923.py b/tests/hermes_cli/test_opencode_zen_free_only_20260923.py
new file mode 100644
--- /dev/null
+++ b/tests/hermes_cli/test_opencode_zen_free_only_20260923.py
@@ -0,0 +1,97 @@
+from __future__ import annotations
+
+import time
+from unittest.mock import patch
+
+import hermes_cli.model_switch as switch_mod
+import hermes_cli.models as models_mod
+from hermes_cli.model_switch import list_picker_providers
+from hermes_cli.models import (
+    cached_provider_model_ids,
+    provider_model_ids,
+    validate_requested_model,
+)
+
+
+def test_zen_provider_catalog_fails_closed_even_if_live_or_curated_has_models(monkeypatch):
+    class _Profile:
+        auth_type = "api_key"
+        base_url = "https://opencode.ai/zen/v1"
+        fallback_models = ("gpt-6-sol", "big-pickle")
+
+        def fetch_models(self, **_kwargs):
+            return ["gpt-6-sol", "big-pickle", "jev-1.13-free"]
+
+    monkeypatch.setattr("providers.get_provider_profile", lambda _name: _Profile())
+    monkeypatch.setattr(
+        "hermes_cli.auth.resolve_api_key_provider_credentials",
+        lambda _name: {"api_key": "test", "base_url": "https://opencode.ai/zen/v1"},
+    )
+    monkeypatch.setattr(models_mod, "_merge_with_models_dev", lambda _provider, curated: list(curated))
+    assert provider_model_ids("opencode-zen", force_refresh=True) == []
+
+
+def test_zen_stale_cache_cannot_resurrect_models(monkeypatch):
+    monkeypatch.setattr(
+        models_mod,
+        "_load_provider_models_cache",
+        lambda: {
+            "opencode-zen": {
+                "fp": "same",
+                "at": time.time(),
+                "models": ["gpt-6-sol", "big-pickle"],
+            }
+        },
+    )
+    monkeypatch.setattr(models_mod, "_credential_fingerprint", lambda _provider: "same")
+    assert cached_provider_model_ids("opencode-zen") == []
+def test_zen_typed_model_requests_are_rejected_before_live_validation():
+    for model in (
+        "gpt-6-sol",
+        "big-pickle",
+        "space-bunny-free",
+        "mimo-v2.6-flash-free",
+        "muse-spark-1.3-contributor-free",
+        "jev-1.13-free",
+    ):
+        result = validate_requested_model(
+            model,
+            "opencode-zen",
+            api_key="test-key",
+            base_url="https://opencode.ai/zen/v1",
+        )
+        assert result["accepted"] is False
+        assert result["persist"] is False
+        assert result["recognized"] is False
+        assert "free-only" in (result["message"] or "").lower()
+
+
+def test_shared_picker_hides_zen_even_if_current_provider_row_contains_old_model(monkeypatch):
+    monkeypatch.setattr(
+        switch_mod,
+        "list_authenticated_providers",
+        lambda **_kwargs: [
+            {
+                "slug": "opencode-zen",
+                "name": "OpenCode Zen",
+                "models": ["gpt-6-sol"],
+                "total_models": 1,
+                "is_current": True,
+                "is_user_defined": False,
+            },
+            {
+                "slug": "deepseek",
+                "name": "DeepSeek",
+                "models": ["deepseek-flash"],
+                "total_models": 1,
+                "is_current": False,
+                "is_user_defined": False,
+            },
+        ],
+    )
+    rows = list_picker_providers(
+        current_provider="opencode-zen",
+        current_model="gpt-6-sol",
+    )
+    assert all(row["slug"] != "opencode-zen" for row in rows)
+    assert any(row["slug"] == "deepseek" for row in rows)
