+def _walk_session_ids(
+    start: Optional[str],
+    next_id: Callable[[str], Optional[str]],
+) -> List[str]:
+    """Follow a session-ID edge until the chain ends or repeats.
+
+    Compression depth is data-dependent and has no safe magic ceiling. The
+    visited-set is the safety boundary: malformed/cyclic data stops the walk
+    without silently selecting an arbitrary fixed-depth predecessor.
+    """
+    chain: List[str] = []
+    seen: set[str] = set()
+    current = start
+    while current and current not in seen:
+        seen.add(current)
+        chain.append(current)
+        current = next_id(current)
+    return chain
 
 
