+    def _make_long_compression_chain(self, db, length=218, prefix="long"):
+        ids = [f"{prefix}_0"]
+        db.create_session(ids[0], "cli")
+        current = ids[0]
+        for index in range(1, length + 1):
+            db.end_session(current, "compression")
+            child = f"{prefix}_{index}"
+            db.create_session(child, "cli", parent_session_id=current)
+            ids.append(child)
+            current = child
+        return ids
+
+    def test_compression_tip_follows_more_than_100_continuations(self, db):
+        ids = self._make_long_compression_chain(db)
+
+        assert db.get_compression_tip(ids[0]) == ids[-1]
+
+    def test_lineage_root_to_tip_follows_more_than_100_parents(self, db):
+        ids = self._make_long_compression_chain(db, prefix="lineage")
+
+        assert db._session_lineage_root_to_tip(ids[-1]) == ids
+
+    def test_lineage_walkers_stop_on_cycles(self, db):
+        db.create_session("cycle_a", "cli")
+        db.create_session("cycle_b", "cli", parent_session_id="cycle_a")
+        db.end_session("cycle_a", "compression")
+        db.end_session("cycle_b", "compression")
+        db._conn.execute(
+            "UPDATE sessions SET parent_session_id = ? WHERE id = ?",
+            ("cycle_b", "cycle_a"),
+        )
+        db._conn.commit()
+
+        assert db.get_compression_tip("cycle_a") == "cycle_b"
+        assert set(db._session_lineage_root_to_tip("cycle_a")) == {
+            "cycle_a",
+            "cycle_b",
+        }
 
