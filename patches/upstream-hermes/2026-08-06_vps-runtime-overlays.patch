@@ -0,0 +1,177 @@
+"""ExecutionContext — universal context for child processes.
+
+Inherits from RuntimeContext by composition, not re-resolution.
+Plugins, subagents, cron, MCP, ACP, and auxiliary clients all consume
+this contract instead of independently re-resolving runtime state.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+from datetime import datetime, timezone
+from typing import Any, Dict, Optional
+
+from hermes_cli.runtime_context import (
+    RuntimeContext,
+    CapabilityView,
+    SourceTier,
+    FallbackState,
+)
+
+__all__ = [
+    "RequestMetadata",
+    "TokenUsage",
+    "ExecutionContext",
+    "build_execution_context",
+]
+
+
+@dataclasses.dataclass
+class TokenUsage:
+    """Token consumption for a single request."""
+    prompt_tokens: int = 0
+    completion_tokens: int = 0
+    total_tokens: int = 0
+
+
+@dataclasses.dataclass
+class RequestMetadata:
+    """Per-request metadata embedded inside ExecutionContext.
+    
+    NOT a standalone state object. Populated per API call for observability.
+    """
+    retry_count: int = 0
+    latency_ms: float = 0.0
+    token_usage: TokenUsage = dataclasses.field(default_factory=TokenUsage)
+
+
+@dataclasses.dataclass(frozen=True)
+class ExecutionContext:
+    """Universal context delivery wrapper for child execution boundaries.
+    
+    Consumes RuntimeContext — does NOT compete with it.
+    Created at context boundaries (spawn, delegate, cron fire).
+    Immutable after creation.
+    
+    Inheritance rules:
+    - Default: inherit everything from parent (model, provider, credentials)
+    - Explicit override: child MAY override specific fields per tool contract
+    - Re-resolution: child MUST use RuntimeResolver if it needs a different model,
+      NOT reconstruct ExecutionContext from scratch
+    """
+    runtime: RuntimeContext
+    trace_id: str
+    parent_session_id: Optional[str] = None
+    environment_overrides: Dict[str, str] = dataclasses.field(default_factory=dict)
+    capabilities_view: CapabilityView = dataclasses.field(default_factory=CapabilityView)
+    request_metadata: RequestMetadata = dataclasses.field(default_factory=RequestMetadata)
+    created_at: datetime = dataclasses.field(
+        default_factory=lambda: datetime.now(timezone.utc)
+    )
+
+    # ------------------------------------------------------------------ #
+    # Convenience accessors — delegate through RuntimeContext fields      #
+    # These ensure consumers read ONE source of truth (RuntimeContext).   #
+    # ------------------------------------------------------------------ #
+
+    @property
+    def model(self) -> str:
+        return self.runtime.model
+
+    @property
+    def provider(self) -> str:
+        return self.runtime.provider
+
+    @property
+    def base_url(self) -> str:
+        return self.runtime.base_url
+
+    @property
+    def api_mode(self) -> str:
+        return self.runtime.api_mode
+
+    @property
+    def generation_id(self) -> int:
+        """Propagate generation_id for stale-context detection."""
+        return self.runtime.generation_id
+
+    @property
+    def fallback_state(self) -> FallbackState:
+        return self.runtime.fallback_state
+
+    @property
+    def source_tier(self) -> SourceTier:
+        return self.runtime.source_tier
+
+    def to_dict(self) -> Dict[str, Any]:
+        """Serialize to dict for logging/debugging."""
+        return {
+            "trace_id": self.trace_id,
+            "parent_session_id": self.parent_session_id,
+            "runtime": self.runtime.to_dict(),
+            "created_at": self.created_at.isoformat(),
+        }
+
+
+def build_execution_context(
+    runtime: RuntimeContext,
+    trace_id: str,
+    parent_session_id: Optional[str] = None,
+    environment_overrides: Optional[Dict[str, str]] = None,
+) -> ExecutionContext:
+    """Factory to create an ExecutionContext from a resolved RuntimeContext.
+    
+    Use this in Phase 1 to wrap existing resolution results.
+    Phase 2 callers should receive ExecutionContext directly.
+    """
+    return ExecutionContext(
+        runtime=runtime,
+        trace_id=trace_id,
+        parent_session_id=parent_session_id,
+        environment_overrides=environment_overrides or {},
+        capabilities_view=runtime.capabilities_view,
+    )
+
+
+def build_execution_context_from_agent(
+    agent: Any,
+    trace_id: Optional[str] = None,
+    parent_session_id: Optional[str] = None,
+) -> ExecutionContext:
+    """Build ExecutionContext from an agent's runtime attributes.
+    
+    Phase 1 helper — reads agent.model, agent.provider, etc. to construct
+    an ExecutionContext without requiring RuntimeResolver.
+    Phase 2 should receive ExecutionContext directly from upstream.
+    """
+    import uuid
+
+    from hermes_cli.runtime_context import (
+        RuntimeContext,
+        SourceTier,
+        FallbackState,
+    )
+
+    runtime = RuntimeContext(
+        model=getattr(agent, "model", ""),
+        provider=getattr(agent, "provider", ""),
+        base_url=getattr(agent, "base_url", ""),
+        api_mode=getattr(agent, "api_mode", "chat_completions"),
+        api_key=getattr(agent, "api_key", "") or "",
+        source_tier=SourceTier.PROVIDER_RUNTIME,
+        resolution_reason=getattr(agent, "_resolution_reason", "") or "inherited_from_parent",
+        fallback_state=(
+            FallbackState.ACTIVE_PROVIDER_FAILED
+            if getattr(agent, "_fallback_activated", False)
+            else FallbackState.INACTIVE
+        ),
+    )
+
+    _trace_id = trace_id or f"agent_{uuid.uuid4().hex[:8]}"
+
+    return ExecutionContext(
+        runtime=runtime,
+        trace_id=_trace_id,
+        parent_session_id=parent_session_id,
+        capabilities_view=runtime.capabilities_view,
+    )
