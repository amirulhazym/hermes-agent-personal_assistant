+"""Integration-level tests for the base adapter delivery observability boundary."""
+
+from __future__ import annotations
+
+import asyncio
+import json
+from gateway.config import Platform
+from gateway.observability import bind_context, reset_context
+from gateway.platforms.base import BasePlatformAdapter, SendResult
+
+
+class _DummyAdapter(BasePlatformAdapter):
+    async def connect(self):
+        return None
+
+    async def disconnect(self):
+        return None
+
+    async def get_chat_info(self, chat_id):
+        return {}
+
+    async def send(self, **kwargs):
+        raise AssertionError("test send stub was not installed")
+
+
+def _adapter_with_send(results):
+    adapter = object.__new__(_DummyAdapter)
+    adapter.platform = Platform.WHATSAPP
+    calls = []
+
+    async def _send(**kwargs):
+        calls.append(kwargs)
+        return results.pop(0)
+
+    adapter.send = _send
+    adapter._is_retryable_error = lambda _error: False
+    adapter._is_timeout_error = lambda _error: False
+    adapter._test_calls = calls
+    return adapter
+
+
+def test_send_with_retry_records_adapter_acceptance(monkeypatch, tmp_path):
+    from gateway import observability
+
+    event_path = tmp_path / "gateway-observability.jsonl"
+    monkeypatch.setattr(observability, "_event_path", lambda: event_path)
+    token = bind_context(
+        "corr-delivery",
+        platform="whatsapp",
+        inbound_message_id="inbound-1",
+    )
+    try:
+        adapter = _adapter_with_send([SendResult(success=True, message_id="outbound-1")])
+        result = asyncio.run(
+            BasePlatformAdapter._send_with_retry(
+                adapter,
+                chat_id="chat-1",
+                content="private response body must not be logged",
+                reply_to="inbound-1",
+                max_retries=0,
+            )
+        )
+    finally:
+        reset_context(token)
+
+    assert result.success is True
+    rows = [json.loads(line) for line in event_path.read_text().splitlines()]
+    started, outcome = rows
+    assert started["event"] == "outbound_send_started"
+    assert outcome["event"] == "outbound_adapter_result"
+    assert started["correlation_id"] == "corr-delivery"
+    assert outcome["adapter_accepted"] is True
+    assert outcome["destination_observed"] is None
+    assert outcome["message_id"] == "outbound-1"
+    assert started["reply_to_message_id"] == "inbound-1"
+    assert "private response body" not in event_path.read_text()
+
+
+def test_send_with_retry_records_each_retry(monkeypatch, tmp_path):
+    from gateway import observability
+
+    event_path = tmp_path / "gateway-observability.jsonl"
+    monkeypatch.setattr(observability, "_event_path", lambda: event_path)
+    adapter = _adapter_with_send(
+        [
+            SendResult(success=False, error="temporary", retryable=True),
+            SendResult(success=True, message_id="outbound-2"),
+        ]
+    )
+
+    result = asyncio.run(
+        BasePlatformAdapter._send_with_retry(
+            adapter,
+            chat_id="chat-1",
+            content="response",
+            reply_to="inbound-2",
+            max_retries=1,
+            base_delay=0,
+        )
+    )
+
+    assert result.success is True
+    rows = [json.loads(line) for line in event_path.read_text().splitlines()]
+    attempts = [row for row in rows if row["event"] == "outbound_send_started"]
+    outcomes = [row for row in rows if row["event"] == "outbound_adapter_result"]
+    assert [row["attempt"] for row in attempts] == [1, 2]
+    assert [row["status"] for row in outcomes] == ["failed", "success"]
