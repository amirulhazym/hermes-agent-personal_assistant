@@ -0,0 +1,181 @@
+"""Runtime context types for Hermes model resolution.
+
+Single source of truth for runtime resolution state.
+See design doc: ~/.hermes/design/runtime-resolver-architecture.md
+"""
+
+from __future__ import annotations
+
+import dataclasses
+from datetime import datetime, timezone
+from enum import Enum, auto
+from typing import Any, Dict, List, Optional
+
+__all__ = [
+    "SourceTier",
+    "FallbackState",
+    "TokenUsage",
+    "CapabilityView",
+    "FallbackEntry",
+    "RuntimeContext",
+    "RuntimeContextError",
+]
+
+
+class RuntimeContextError(Exception):
+    """Raised when RuntimeContext invariants are violated."""
+
+
+class SourceTier(Enum):
+    """Categorical origin of the resolution outcome."""
+    CONFIG = "config"
+    SESSION_OVERRIDE = "session_override"
+    CREDENTIAL_POOL = "credential_pool"
+    PROVIDER_RUNTIME = "provider_runtime"
+    FALLBACK = "fallback"
+    DEFAULT = "default"
+
+    @classmethod
+    def _missing_(cls, value: object) -> SourceTier:
+        if isinstance(value, str):
+            for member in cls:
+                if member.value == value.lower():
+                    return member
+        return cls.DEFAULT
+
+
+class FallbackState(Enum):
+    """Tracks whether fallback activated and for what reason."""
+    INACTIVE = "inactive"
+    ACTIVE_PRIMARY_DEGRADED = "active_primary_degraded"
+    ACTIVE_PROVIDER_FAILED = "active_provider_failed"
+    ACTIVE_CREDENTIAL_EXPIRED = "active_credential_expired"
+
+
+@dataclasses.dataclass
+class TokenUsage:
+    """Token consumption for a single request."""
+    prompt_tokens: int = 0
+    completion_tokens: int = 0
+    total_tokens: int = 0
+
+
+@dataclasses.dataclass(frozen=True)
+class CapabilityView:
+    """Derived capabilities computed from (provider, model, api_mode).
+    
+    NEVER stored independently. Computed on demand from RuntimeContext fields.
+    """
+    reasoning: bool = False
+    vision: bool = False
+    streaming: bool = False
+    structured_output: bool = False
+    tool_use: bool = False
+    capability_profile: str = ""
+
+
+@dataclasses.dataclass(frozen=True)
+class FallbackEntry:
+    """A single entry in the fallback chain.
+    
+    Pre-resolved at agent init from config.yaml fallbacks section.
+    """
+    provider: str
+    model: str
+    base_url: str = ""
+    api_key: str = ""
+    api_mode: str = "chat_completions"
+
+
+# Module-level monotonic counter for generation_id.
+_generation_counter: int = 0
+
+
+def _next_generation() -> int:
+    global _generation_counter
+    _generation_counter += 1
+    return _generation_counter
+
+
+@dataclasses.dataclass(frozen=True)
+class RuntimeContext:
+    """Authoritative runtime state — single source of truth for all consumers.
+    
+    Frozen/immutable after construction. Use replace() for fallback re-resolution.
+    All consumers MUST check generation_id to detect stale contexts.
+    
+    Invariants (enforced in constructor):
+        R01: provider is non-empty string
+        R02: api_mode is non-empty string  
+        R03: source_tier is valid SourceTier enum
+        R06: configured and requested are tracked alongside effective
+    """
+    generation_id: int = dataclasses.field(default_factory=_next_generation)
+    model: str = ""
+    provider: str = ""
+    base_url: str = ""
+    api_mode: str = "chat_completions"
+    api_key: str = ""
+    source_tier: SourceTier = SourceTier.DEFAULT
+    resolution_reason: str = ""
+    fallback_state: FallbackState = FallbackState.INACTIVE
+    fallback_chain: List[FallbackEntry] = dataclasses.field(default_factory=list)
+    requested: Optional[str] = None
+    configured: str = ""
+    primary_resolution: Optional["RuntimeContext"] = None
+    created_at: datetime = dataclasses.field(
+        default_factory=lambda: datetime.now(timezone.utc)
+    )
+    expires_at: Optional[datetime] = None
+    capabilities_view: CapabilityView = dataclasses.field(
+        default_factory=CapabilityView
+    )
+
+    def __post_init__(self) -> None:
+        """Validate invariants R01, R02, R03, R06."""
+        # R01: provider must be non-empty
+        if not self.provider:
+            raise RuntimeContextError("R01: provider must be non-empty string")
+        # R02: api_mode must be non-empty
+        if not self.api_mode:
+            raise RuntimeContextError("R02: api_mode must be non-empty string")
+        # R03: source_tier must be a valid SourceTier enum
+        if not isinstance(self.source_tier, SourceTier):
+            raise RuntimeContextError(
+                f"R03: source_tier must be SourceTier enum, got {type(self.source_tier)}"
+            )
+        # R06: configured defaults to model if not explicitly set
+        if not self.configured:
+            object.__setattr__(self, "configured", self.model)
+
+    def to_dict(self) -> Dict[str, Any]:
+        """Serialize to JSON-compatible dict for logging and backward compat."""
+        return {
+            "generation_id": self.generation_id,
+            "model": self.model,
+            "provider": self.provider,
+            "base_url": self.base_url,
+            "api_mode": self.api_mode,
+            "api_key": self._masked_key(),
+            "source_tier": self.source_tier.value,
+            "resolution_reason": self.resolution_reason,
+            "fallback_state": self.fallback_state.value,
+            "requested": self.requested,
+            "configured": self.configured,
+            "created_at": self.created_at.isoformat(),
+        }
+
+    def replace(self, **kwargs: Any) -> "RuntimeContext":
+        """Create a new RuntimeContext with specified fields replaced.
+        
+        Preserves generation_id auto-increment (new context gets new id).
+        Used for fallback re-resolution.
+        """
+        return dataclasses.replace(self, **kwargs)
+
+    def _masked_key(self) -> str:
+        if not self.api_key:
+            return ""
+        if len(self.api_key) <= 8:
+            return "***"
+        return self.api_key[:4] + "..." + self.api_key[-4:]
