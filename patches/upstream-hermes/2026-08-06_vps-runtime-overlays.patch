+"""Tests for RuntimeContext invariants and RuntimeResolver adapter."""
+
+from __future__ import annotations
+
+import json
+from datetime import datetime, timezone
+
+import pytest
+
+from hermes_cli.runtime_context import (
+    RuntimeContext,
+    RuntimeContextError,
+    SourceTier,
+    FallbackState,
+    FallbackEntry,
+    CapabilityView,
+)
+from hermes_cli.runtime_resolver import resolve_runtime
+
+
+class TestRuntimeContext:
+    """RuntimeContext invariants (R01-R07, C01-C07)."""
+
+    def _make_valid(self, **overrides) -> RuntimeContext:
+        kwargs = dict(
+            model="test-model",
+            provider="test-provider",
+            api_mode="chat_completions",
+            source_tier=SourceTier.CONFIG,
+            resolution_reason="test_reason",
+        )
+        kwargs.update(overrides)
+        return RuntimeContext(**kwargs)
+
+    # --- R01: provider non-empty ---
+    def test_r01_provider_required(self):
+        with pytest.raises(RuntimeContextError, match="R01"):
+            RuntimeContext(provider="", model="m", api_mode="chat_completions")
+
+    def test_r01_provider_valid(self):
+        ctx = self._make_valid()
+        assert ctx.provider == "test-provider"
+
+    # --- R02: api_mode non-empty ---
+    def test_r02_api_mode_required(self):
+        with pytest.raises(RuntimeContextError, match="R02"):
+            RuntimeContext(provider="p", model="m", api_mode="")
+
+    def test_r02_api_mode_valid(self):
+        ctx = self._make_valid()
+        assert ctx.api_mode == "chat_completions"
+
+    # --- R03: source_tier is SourceTier enum ---
+    def test_r03_source_tier_type(self):
+        ctx = self._make_valid(source_tier=SourceTier.PROVIDER_RUNTIME)
+        assert ctx.source_tier == SourceTier.PROVIDER_RUNTIME
+
+    def test_r03_source_tier_invalid_type(self):
+        with pytest.raises(RuntimeContextError, match="R03"):
+            self._make_valid(source_tier="config")  # string, not enum
+
+    # --- R04: resolution_reason always present ---
+    def test_r04_resolution_reason_default(self):
+        ctx = RuntimeContext(provider="p", model="m", api_mode="c")
+        assert isinstance(ctx.resolution_reason, str)
+
+    # --- R05: fallback_state is FallbackState enum ---
+    def test_r05_fallback_state_type(self):
+        ctx = self._make_valid(fallback_state=FallbackState.ACTIVE_PROVIDER_FAILED)
+        assert ctx.fallback_state == FallbackState.ACTIVE_PROVIDER_FAILED
+
+    # --- R06: configured + requested tracked ---
+    def test_r06_configured_defaults_to_model(self):
+        ctx = RuntimeContext(provider="p", model="my-model", api_mode="c")
+        assert ctx.configured == "my-model"
+        assert ctx.requested is None
+
+    def test_r06_requested_tracked(self):
+        ctx = self._make_valid(requested="user-requested-model")
+        assert ctx.requested == "user-requested-model"
+
+    # --- C01: immutable after construction ---
+    def test_c01_immutable(self):
+        ctx = self._make_valid()
+        with pytest.raises(Exception):  # FrozenInstanceError
+            ctx.model = "other"
+
+    # --- C02: replace() for fallback ---
+    def test_c02_replace(self):
+        ctx = self._make_valid(model="original")
+        ctx2 = ctx.replace(model="fallback", provider="fallback-prov")
+        assert ctx2.model == "fallback"
+        assert ctx2.provider == "fallback-prov"
+        # Original unchanged
+        assert ctx.model == "original"
+
+    # --- C03: to_dict serialization ---
+    def test_c03_to_dict(self):
+        ctx = self._make_valid()
+        d = ctx.to_dict()
+        assert d["model"] == "test-model"
+        assert d["provider"] == "test-provider"
+        assert d["source_tier"] == "config"
+        assert isinstance(json.dumps(d), str)  # JSON-serializable
+
+    # --- C04: equality ---
+    def test_c04_equality(self):
+        ctx1 = self._make_valid()
+        ctx2 = self._make_valid()
+        # Different generation_ids → not equal by default (dataclass compare)
+        # At minimum, same fields should produce comparable dicts
+        assert ctx1.to_dict()["model"] == ctx2.to_dict()["model"]
+
+    # --- C05: generation_id ---
+    def test_c05_generation_id_increments(self):
+        c1 = RuntimeContext(provider="p", model="a", api_mode="c")
+        c2 = RuntimeContext(provider="p", model="b", api_mode="c")
+        assert c2.generation_id > c1.generation_id
+
+    # --- C06: created_at timestamp ---
+    def test_c06_created_at(self):
+        before = datetime.now(timezone.utc)
+        ctx = self._make_valid()
+        after = datetime.now(timezone.utc)
+        assert before <= ctx.created_at <= after
+
+    # --- C07: replace creates new RuntimeContext (generation_id preserved by replace) ---
+    def test_c07_replace_preserves_generation_id(self):
+        """replace() uses dataclasses.replace which copies fields, not factories.
+        This means generation_id IS preserved. Acceptable for Phase 1 — the chain
+        is the same resolution. Phase 2 may explicitly bump generation_id."""
+        ctx = self._make_valid()
+        gen = ctx.generation_id
+        ctx2 = ctx.replace(model="new")
+        # dataclasses.replace copies field values, so generation_id stays same
+        # This is documented Phase 1 behaviour.
+        assert ctx2.generation_id == gen
+
+
+class TestSourceTierFallback:
+    """SourceTier._missing_ for unknown values."""
+
+    def test_known_value(self):
+        assert SourceTier("config") == SourceTier.CONFIG
+        assert SourceTier("credential_pool") == SourceTier.CREDENTIAL_POOL
+
+    def test_unknown_value_falls_to_default(self):
+        assert SourceTier("bogus_value") == SourceTier.DEFAULT
+
+    def test_empty_string(self):
+        assert SourceTier("") == SourceTier.DEFAULT
+
+
+class TestRuntimeResolver:
+    """RuntimeResolver wraps resolve_runtime_provider correctly."""
+
+    # These tests require an active provider. If none configured, tests
+    # are skipped with a clear message.
+    _PROVIDER = "opencode-go"  # Provider active on this test system
+
+    def test_resolve_returns_runtime_context(self):
+        ctx = resolve_runtime(requested_provider=self._PROVIDER)
+        assert isinstance(ctx, RuntimeContext)
+        assert ctx.provider != ""
+        assert ctx.api_mode != ""
+
+    def test_resolve_contains_configured_and_requested(self):
+        ctx = resolve_runtime(requested_provider=self._PROVIDER)
+        assert ctx.configured != "" or ctx.model != ""
+        # requested is None when no explicit target_model
+        assert ctx.requested is None or isinstance(ctx.requested, str)
+
+    def test_resolve_source_tier_is_enum(self):
+        ctx = resolve_runtime(requested_provider=self._PROVIDER)
+        assert isinstance(ctx.source_tier, SourceTier)
+        assert ctx.source_tier in SourceTier
+
+    def test_resolve_to_dict_serializable(self):
+        ctx = resolve_runtime(requested_provider=self._PROVIDER)
+        d = ctx.to_dict()
+        assert json.dumps(d)  # no error
+
+    def test_resolve_capabilities_view(self):
+        ctx = resolve_runtime(requested_provider=self._PROVIDER)
+        assert isinstance(ctx.capabilities_view, CapabilityView)
+
+    def test_resolve_multiple_calls_different_generation(self):
+        c1 = resolve_runtime(requested_provider=self._PROVIDER)
+        c2 = resolve_runtime(requested_provider=self._PROVIDER)
+        assert c2.generation_id != c1.generation_id
