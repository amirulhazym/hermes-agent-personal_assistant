@@ -0,0 +1,111 @@
+"""Tests for ExecutionContext inheritance."""
+
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+from hermes_cli.execution_context import (
+    ExecutionContext,
+    build_execution_context,
+    build_execution_context_from_agent,
+)
+from hermes_cli.runtime_context import RuntimeContext, SourceTier, FallbackState
+
+
+class TestExecutionContextConstruction:
+    """ExecutionContext can be built from both RuntimeContext and agent."""
+
+    def test_build_from_runtime_context(self):
+        rt = RuntimeContext(
+            model="test-m", provider="test-p", api_mode="chat_completions",
+            source_tier=SourceTier.CONFIG, resolution_reason="direct",
+        )
+        ctx = build_execution_context(rt, trace_id="t1")
+        assert ctx.model == "test-m"
+        assert ctx.provider == "test-p"
+        assert ctx.generation_id == rt.generation_id
+        assert ctx.trace_id == "t1"
+
+    def test_build_from_agent(self):
+        agent = SimpleNamespace(
+            model="agent-m", provider="agent-p", base_url="https://a.ai",
+            api_mode="chat_completions", api_key="sk-a",
+            _resolution_reason="inherited", _fallback_activated=False,
+        )
+        ctx = build_execution_context_from_agent(agent)
+        assert ctx.model == "agent-m"
+        assert ctx.provider == "agent-p"
+        assert ctx.runtime.source_tier == SourceTier.PROVIDER_RUNTIME
+
+    def test_build_from_agent_with_fallback(self):
+        agent = SimpleNamespace(
+            model="fb-model", provider="fb-prov", base_url="",
+            api_mode="chat_completions", api_key="",
+            _resolution_reason="provider_x_failed", _fallback_activated=True,
+        )
+        ctx = build_execution_context_from_agent(agent)
+        assert ctx.runtime.fallback_state == FallbackState.ACTIVE_PROVIDER_FAILED
+        assert "failed" in ctx.runtime.resolution_reason
+
+    def test_frozen_immutable(self):
+        rt = RuntimeContext(
+            model="m", provider="p", api_mode="c",
+            source_tier=SourceTier.CONFIG,
+        )
+        ctx = build_execution_context(rt, trace_id="t")
+        try:
+            ctx.model = "other"
+            assert False, "should be immutable"
+        except Exception:
+            pass
+
+    def test_generation_id_propagates(self):
+        rt = RuntimeContext(
+            model="m", provider="p", api_mode="c",
+            source_tier=SourceTier.CONFIG,
+        )
+        gen1 = rt.generation_id
+        rt2 = RuntimeContext(
+            model="m2", provider="p2", api_mode="c",
+            source_tier=SourceTier.CONFIG,
+        )
+        ctx1 = build_execution_context(rt, trace_id="t1")
+        ctx2 = build_execution_context(rt2, trace_id="t2")
+        assert ctx2.generation_id > ctx1.generation_id
+
+
+class TestExecutionContextInheritance:
+    """ExecutionContext is inherited, not re-resolved."""
+
+    def test_parent_context_override_chain(self):
+        """Override priority: explicit > parent_context > parent_agent."""
+        parent_rt = RuntimeContext(
+            model="parent-m", provider="parent-p", api_mode="chat_completions",
+            source_tier=SourceTier.CONFIG,
+        )
+        parent_ctx = build_execution_context(parent_rt, trace_id="parent_trace")
+        assert parent_ctx.model == "parent-m"
+        assert parent_ctx.generation_id is not None
+
+        # Fresh RuntimeContext for child (new generation_id)
+        child_rt = RuntimeContext(
+            model="child-m", provider="child-p", api_mode="chat_completions",
+            source_tier=SourceTier.PROVIDER_RUNTIME,
+        )
+        child_ctx = build_execution_context(child_rt, trace_id="child_trace")
+        assert child_ctx.model == "child-m"
+        assert child_ctx.provider == "child-p"
+        # Each fresh RuntimeContext gets a new generation_id
+        assert child_ctx.generation_id != parent_ctx.generation_id
+
+    def test_to_dict_serializable(self):
+        import json
+        rt = RuntimeContext(
+            model="m", provider="p", api_mode="c",
+            source_tier=SourceTier.CONFIG,
+        )
+        ctx = build_execution_context(rt, trace_id="t")
+        d = ctx.to_dict()
+        assert json.dumps(d)
+        assert d["runtime"]["model"] == "m"
+        assert d["trace_id"] == "t"
