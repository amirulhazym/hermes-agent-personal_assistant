+"""Tests for local gateway observability events."""
+
+from __future__ import annotations
+
+import json
+
+from gateway import observability
+
+
+def test_record_event_writes_structured_jsonl(monkeypatch, tmp_path):
+    event_path = tmp_path / "gateway-observability.jsonl"
+    monkeypatch.setattr(observability, "_event_path", lambda: event_path)
+
+    event_id = observability.record_event(
+        "model_switch_completed",
+        correlation_id="corr-1",
+        status="success",
+        platform="whatsapp",
+        requested_model="model-x",
+        persist_scope="session",
+    )
+
+    row = json.loads(event_path.read_text(encoding="utf-8").strip())
+    assert row["event_id"] == event_id
+    assert row["schema_version"] == 1
+    assert row["event"] == "model_switch_completed"
+    assert row["correlation_id"] == "corr-1"
+    assert row["status"] == "success"
+    assert row["platform"] == "whatsapp"
+    assert row["requested_model"] == "model-x"
+    assert "message" not in row
+    assert "api_key" not in row
+
+
+def test_context_is_merged_and_reset(monkeypatch, tmp_path):
+    event_path = tmp_path / "gateway-observability.jsonl"
+    monkeypatch.setattr(observability, "_event_path", lambda: event_path)
+
+    token = observability.bind_context(
+        "corr-2",
+        platform="whatsapp",
+        inbound_message_id="inbound-1",
+    )
+    try:
+        assert observability.current_context()["correlation_id"] == "corr-2"
+        observability.record_event("response_ready", status="success")
+    finally:
+        observability.reset_context(token)
+
+    row = json.loads(event_path.read_text(encoding="utf-8").strip())
+    assert row["correlation_id"] == "corr-2"
+    assert row["platform"] == "whatsapp"
+    assert row["inbound_message_id"] == "inbound-1"
+    assert observability.current_context() == {}
+
+
+def test_identifier_hash_is_stable_and_non_reversible_shape():
+    first = observability.hash_identifier("13186321408227@lid")
+    second = observability.hash_identifier("13186321408227@lid")
+
+    assert first == second
+    assert first != "13186321408227@lid"
+    assert len(first) == 16
