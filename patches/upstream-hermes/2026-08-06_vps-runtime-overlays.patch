+"""Tests for dashboard read-path alignment and write invariant.
+
+Dashboard MUST NOT write model state — it is a read-only projection.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+
+class TestDashboardReadOnly:
+    """Dashboard reads SessionDB, never writes model state."""
+
+    def test_model_info_contains_runtime(self):
+        """GET /api/model/info returns runtime field with resolution info."""
+        from hermes_cli.web_server import get_model_info
+
+        result = get_model_info()
+        assert isinstance(result, dict)
+        assert "model" in result
+        # runtime field is present (may be empty dict if no provider)
+        assert "runtime" in result
+        assert isinstance(result["runtime"], dict)
+
+    def test_model_info_runtime_has_resolution_reason(self):
+        """When provider configured, runtime contains resolution details."""
+        from hermes_cli.web_server import get_model_info
+
+        result = get_model_info()
+        runtime = result.get("runtime", {})
+        if runtime:  # only check when provider configured
+            assert "source_tier" in runtime
+            assert "resolution_reason" in runtime
+            assert "fallback_state" in runtime
+            assert "generation_id" in runtime
+
+    def test_model_info_persisted_fields(self):
+        """Persisted model fields (model, provider) always present."""
+        from hermes_cli.web_server import get_model_info
+
+        result = get_model_info()
+        assert "model" in result
+        assert "provider" in result
+        # These are the persisted/configured values
+        assert isinstance(result.get("model"), str)
+
+    def test_dashboard_never_writes_model(self):
+        """Verify no UNEXPECTED write endpoints for model state.
+        
+        Known/expected write endpoints:
+        - POST /api/model/set — user-initiated model switch
+        - PUT /api/profiles/{name}/model — profile configuration
+        
+        The DASHBOARD frontend reads via GET /api/model/info and
+        writes via POST /api/model/set (user-initiated). No other
+        write endpoints should exist.
+        """
+        from hermes_cli.web_server import app
+        
+        write_methods = {"POST", "PUT", "PATCH", "DELETE"}
+        model_write_routes = set()
+        
+        for route in app.routes:
+            methods = getattr(route, "methods", set())
+            if methods & write_methods:
+                path = getattr(route, "path", "")
+                if "model" in path.lower():
+                    model_write_routes.add(path)
+        
+        # Known allowed write routes
+        known = {"/api/model/set", "/api/profiles/{name}/model"}
+        
+        # Any unknown write route should be reviewed
+        unexpected = model_write_routes - known
+        assert not unexpected, f"Unexpected model write routes: {unexpected}"
