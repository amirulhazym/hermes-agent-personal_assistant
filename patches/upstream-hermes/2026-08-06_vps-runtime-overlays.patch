new file mode 100644
--- /dev/null
+++ b/hermes_cli/runtime_resolver.py
@@ -0,0 +1,166 @@
+"""RuntimeResolver — wraps existing resolution logic into typed RuntimeContext.
+
+Phase 1a adapter: calls resolve_runtime_provider() and wraps result.
+Phase 1b+: new consumers call RuntimeResolver directly.
+"""
+
+from __future__ import annotations
+
+import logging
+from typing import Any, Dict, Optional
+
+from hermes_cli.runtime_provider import resolve_runtime_provider
+from hermes_cli.runtime_context import (
+    RuntimeContext,
+    SourceTier,
+    FallbackState,
+    FallbackEntry,
+    CapabilityView,
+)
+
+logger = logging.getLogger(__name__)
+
+# Mapping from legacy source strings to SourceTier.
+_SOURCE_TIER_MAP: Dict[str, SourceTier] = {
+    "env": SourceTier.CONFIG,
+    "azure-explicit": SourceTier.CONFIG,
+    "hermes-auth-store": SourceTier.CREDENTIAL_POOL,
+    "portal": SourceTier.PROVIDER_RUNTIME,
+    "oauth": SourceTier.PROVIDER_RUNTIME,
+    "qwen-cli": SourceTier.PROVIDER_RUNTIME,
+    "google-oauth": SourceTier.PROVIDER_RUNTIME,
+    "minimax-oauth": SourceTier.PROVIDER_RUNTIME,
+    "process": SourceTier.PROVIDER_RUNTIME,
+}
+
+
+def _map_source_tier(source: str) -> SourceTier:
+    """Map legacy source string to SourceTier."""
+    if not source:
+        return SourceTier.DEFAULT
+    lower = source.lower()
+    if lower.startswith("env:") or lower.startswith("env_"):
+        return SourceTier.CONFIG
+    return _SOURCE_TIER_MAP.get(lower, SourceTier.DEFAULT)
+
+
+def _build_resolution_reason(source: str, provider: str, fallback_activated: bool) -> str:
+    """Build human-readable resolution reason."""
+    if fallback_activated:
+        return f"provider_fallback_active_on_{provider}"
+    if source.startswith("env:"):
+        return f"resolved_from_env_var_{source[4:]}"
+    if source == "portal":
+        return "resolved_via_nous_portal"
+    if source == "oauth":
+        return "resolved_via_oauth_refresh"
+    if source in ("azure-explicit",):
+        return "resolved_via_azure_anthropic_explicit"
+    if source == "hermes-auth-store":
+        return "resolved_via_credential_pool"
+    if source == "process":
+        return "resolved_via_external_process_provider"
+    return f"resolved" if not source else f"resolved_from_source_{source}"
+
+
+def _map_fallback_state(raw: Dict[str, Any]) -> FallbackState:
+    """Derive fallback state from raw dict."""
+    if raw.get("_fallback_activated"):
+        return FallbackState.ACTIVE_PROVIDER_FAILED
+    return FallbackState.INACTIVE
+
+
+def _build_capabilities(provider: str, api_mode: str) -> CapabilityView:
+    """Derive capability view from provider + api_mode.
+    
+    Phase 1: simple heuristics.
+    Phase 2: replace with model metadata lookup.
+    """
+    profile = api_mode  # e.g. "chat_completions", "codex_responses", "anthropic_messages"
+    
+    # Rough heuristics — refine in Phase 2
+    has_reasoning = api_mode in ("codex_responses", "anthropic_messages")
+    has_vision = api_mode in ("anthropic_messages",) or provider in ("anthropic",)
+    has_streaming = True  # most providers support streaming
+    has_structured = api_mode in ("chat_completions", "codex_responses")
+    has_tool_use = True  # most providers support tool use
+    
+    return CapabilityView(
+        reasoning=has_reasoning,
+        vision=has_vision,
+        streaming=has_streaming,
+        structured_output=has_structured,
+        tool_use=has_tool_use,
+        capability_profile=profile,
+    )
+
+
+def resolve_runtime(
+    *,
+    requested_provider: Optional[str] = None,
+    target_model: Optional[str] = None,
+    explicit_api_key: Optional[str] = None,
+    explicit_base_url: Optional[str] = None,
+) -> RuntimeContext:
+    """Resolve runtime provider and return typed RuntimeContext.
+    
+    Primary entry point for all new consumers.
+    Old consumers use resolve_runtime_provider() via adapter (unchanged).
+    """
+    raw = resolve_runtime_provider(
+        requested=requested_provider,
+        target_model=target_model,
+        explicit_api_key=explicit_api_key,
+        explicit_base_url=explicit_base_url,
+    )
+
+    provider = raw.get("provider", "openrouter")
+    api_mode = raw.get("api_mode", "chat_completions")
+    base_url = raw.get("base_url", "")
+    api_key = raw.get("api_key", "")
+    source_raw = raw.get("source", "")
+    requested_raw = raw.get("requested_provider", requested_provider or "")
+
+    # requested field = what user ASKED for (model name), not which provider resolved.
+    # If no explicit request was made, requested = None (same as configured).
+    user_requested_model = target_model or (requested_provider if requested_provider and requested_provider != "auto" else None)
+
+    source_tier = _map_source_tier(source_raw)
+    fallback_state = _map_fallback_state(raw)
+    resolution_reason = _build_resolution_reason(
+        source_raw, provider, raw.get("_fallback_activated", False)
+    )
+
+    # Determine configured model from config
+    configured_model = ""
+    effective_model = ""
+    try:
+        from hermes_cli.config import load_config
+        cfg = load_config()
+        model_cfg = cfg.get("model", {})
+        if isinstance(model_cfg, dict):
+            configured_model = model_cfg.get("default", "") or model_cfg.get("model", "")
+        effective_model = configured_model
+        
+        # Check session override if available
+        # (session override is stored per-gateway-session, not accessible here)
+    except Exception:
+        pass
+
+    # If effective_model is still empty, use a meaningful label from provider
+    if not effective_model:
+        effective_model = f"{provider}-auto"
+
+    return RuntimeContext(
+        model=effective_model,
+        provider=provider,
+        base_url=base_url,
+        api_mode=api_mode,
+        api_key=api_key,
+        source_tier=source_tier,
+        resolution_reason=resolution_reason,
+        fallback_state=fallback_state,
+        requested=user_requested_model,
+        configured=configured_model or provider,
+        capabilities_view=_build_capabilities(provider, api_mode),
+    )
