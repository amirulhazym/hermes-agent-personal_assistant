+++ b/gateway/observability.py
@@ -0,0 +1,180 @@
+"""Local-only, fail-open gateway observability.
+
+This module records small structured JSONL events under ``$HERMES_HOME/logs``.
+It never sends telemetry outside the machine and intentionally excludes message
+bodies, prompts, credentials, and raw chat identifiers.
+"""
+
+from __future__ import annotations
+
+import contextvars
+import hashlib
+import json
+import logging
+import threading
+import time
+import uuid
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+from hermes_constants import get_hermes_home
+
+logger = logging.getLogger(__name__)
+
+_SCHEMA_VERSION = 1
+_CONTEXT: contextvars.ContextVar[dict[str, Any]] = contextvars.ContextVar(
+    "hermes_gateway_observability_context",
+    default={},
+)
+_WRITE_LOCK = threading.Lock()
+_SENSITIVE_KEY_PARTS = (
+    "api_key",
+    "apikey",
+    "access_token",
+    "refresh_token",
+    "authorization",
+    "password",
+    "secret",
+    "credential",
+    "private_key",
+)
+
+
+def _event_path() -> Path:
+    """Return the local JSONL sink path, resolving HERMES_HOME dynamically."""
+    return get_hermes_home() / "logs" / "gateway-observability.jsonl"
+
+
+def hash_identifier(value: Any) -> str:
+    """Return a stable short hash for a chat/user identifier."""
+    return hashlib.sha256(str(value).encode("utf-8")).hexdigest()[:16]
+
+
+def new_correlation_id() -> str:
+    return uuid.uuid4().hex
+
+
+def current_context() -> dict[str, Any]:
+    """Return the current task-local context without exposing private timing data."""
+    return dict(_CONTEXT.get() or {})
+
+
+def bind_context(correlation_id: str | None = None, **fields: Any):
+    """Bind correlation and non-sensitive fields to the current async task."""
+    context = current_context()
+    if correlation_id:
+        context["correlation_id"] = correlation_id
+    context.update(fields)
+    context["_started_monotonic"] = context.get("_started_monotonic", time.monotonic())
+    return _CONTEXT.set(context)
+
+
+def reset_context(token) -> None:
+    """Restore the previous task-local context; cleanup is fail-open."""
+    try:
+        _CONTEXT.reset(token)
+    except Exception:
+        logger.debug("Gateway observability context reset failed", exc_info=True)
+
+
+def _is_sensitive_key(key: str) -> bool:
+    lowered = key.lower()
+    return any(part in lowered for part in _SENSITIVE_KEY_PARTS)
+
+
+def _json_safe(value: Any) -> Any:
+    if value is None or isinstance(value, (str, int, float, bool)):
+        return value
+    if isinstance(value, dict):
+        return {
+            str(key): _json_safe(item)
+            for key, item in value.items()
+            if not _is_sensitive_key(str(key))
+        }
+    if isinstance(value, (list, tuple, set)):
+        return [_json_safe(item) for item in value]
+    return str(value)
+
+
+def record_event(event: str, *, correlation_id: str | None = None, **fields: Any) -> str:
+    """Append one structured event and return its event ID.
+
+    Any filesystem or serialization problem is deliberately swallowed. Logging
+    must not block inbound handling or outbound delivery.
+    """
+    event_id = uuid.uuid4().hex
+    try:
+        context = current_context()
+        if correlation_id:
+            context["correlation_id"] = correlation_id
+        started = context.pop("_started_monotonic", None)
+        row: dict[str, Any] = {
+            "schema_version": _SCHEMA_VERSION,
+            "event_id": event_id,
+            "event": event,
+            "timestamp": datetime.now(timezone.utc).isoformat(),
+        }
+        for key, value in context.items():
+            if not _is_sensitive_key(key):
+                row[key] = _json_safe(value)
+        for key, value in fields.items():
+            if not _is_sensitive_key(key):
+                row[key] = _json_safe(value)
+        if started is not None and "duration_ms" not in row:
+            row["duration_ms"] = round((time.monotonic() - started) * 1000, 3)
+
+        path = _event_path()
+        path.parent.mkdir(parents=True, exist_ok=True)
+        encoded = json.dumps(row, ensure_ascii=False, separators=(",", ":"))
+        with _WRITE_LOCK:
+            with path.open("a", encoding="utf-8") as handle:
+                handle.write(encoded + "\n")
+    except Exception:
+        logger.debug("Gateway observability write failed", exc_info=True)
+    return event_id
+
+
+def bind_inbound_context(event: Any, session_key: str | None = None):
+    """Create a correlation context and record a body-free inbound event."""
+    source = getattr(event, "source", None)
+    platform = getattr(getattr(source, "platform", None), "value", None)
+    if platform is None:
+        platform = str(getattr(source, "platform", "") or "")
+    chat_id = getattr(source, "chat_id", None)
+    try:
+        command = event.get_command() or None
+    except Exception:
+        command = None
+    try:
+        message_type = getattr(getattr(event, "message_type", None), "value", None)
+    except Exception:
+        message_type = None
+
+    correlation_id = new_correlation_id()
+    token = bind_context(
+        correlation_id,
+        platform=platform,
+        chat_id_hash=hash_identifier(chat_id) if chat_id is not None else None,
+        inbound_message_id=getattr(event, "message_id", None),
+        message_type=message_type,
+        command=command,
+        session_key_hash=hash_identifier(session_key) if session_key else None,
+    )
+    record_event(
+        "inbound_received",
+        status="accepted",
+        has_body=False,
+    )
+    return token, correlation_id
+
+
+__all__ = [
+    "bind_context",
+    "bind_inbound_context",
+    "current_context",
+    "hash_identifier",
+    "new_correlation_id",
+    "record_event",
+    "reset_context",
+]
