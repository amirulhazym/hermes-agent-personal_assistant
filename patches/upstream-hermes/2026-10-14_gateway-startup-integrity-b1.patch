+def test_failed_integrity_status_write_stays_unverified_after_repeated_clean_restarts(tmp_path, monkeypatch):
+    """Regression: failed atomic status write must not fail open on clean restart."""
+    import utils
+    from gateway.readiness import collect_runtime_readiness
+
+    _unclean(tmp_path)
+    original_write = utils.atomic_json_write
+    attempted = []
+
+    def fail_integrity_only(path, data, **kwargs):
+        if str(path).endswith("gateway-integrity-verification.json"):
+            attempted.append(str(path))
+            raise OSError("simulated integrity-file write failure")
+        return original_write(path, data, **kwargs)
+
+    monkeypatch.setattr(utils, "atomic_json_write", fail_integrity_only)
+    evidence = ledger.record_startup(home=tmp_path)
+    assert evidence["state_db_integrity"] == "unverified"
+    assert attempted
+    assert not (tmp_path / "state" / "gateway-integrity-verification.json").exists()
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+
+    def assert_unverified():
+        readiness = collect_runtime_readiness(
+            configured_model="test/model",
+            runtime_status={"gateway_state": "running",
+                            "platforms": {"telegram": {"state": "connected"}},
+                            "session_store": {"status": "ok"}},
+        )
+        assert readiness["checks"]["integrity_verification"]["verification_state"] == "unverified"
+        assert readiness["checks"]["integrity_verification"]["status"] == "degraded"
+        assert readiness["status"] == "degraded"
+
+    assert_unverified()
+    incident = evidence["integrity_incident_id"]
+    for _ in range(3):
+        ledger.mark_exited(home=tmp_path)
+        assert ledger.read_prior_exit_label(tmp_path) == "clean"
+        assert ledger.record_startup(home=tmp_path) is None
+        assert_unverified()
+        sentinel = ledger._read_json(ledger.get_lifecycle_sentinel_path(tmp_path))
+        assert sentinel["prior_integrity_incident_id"] == incident
+        assert "prior_unclean_exit" not in sentinel
+
+
