+def get_integrity_verification_path(home: Optional[Path] = None) -> Path:
+    """Small durable integrity status, separate from the lifecycle sentinel/DB."""
+    base = home if home is not None else _process_hermes_home()
+    return base.joinpath(*_INTEGRITY_RELATIVE)
+
+
+def _integrity_incident_id(evidence: Dict[str, Any]) -> str:
+    """Stable identity of the *prior* unclean gateway life, not the new PID."""
+    identity = [evidence.get(key) for key in
+                ("prior_pid", "prior_start_time", "prior_started_at")]
+    return hashlib.sha256(json.dumps(identity, separators=(",", ":"),
+                                     default=str).encode("utf-8")).hexdigest()
+
+
+def _record_pending_integrity(evidence: Dict[str, Any], home: Optional[Path]) -> Dict[str, Any]:
+    """Atomically record an incident; never upgrade an unverified check to verified.
+
+    A retry for the exact same incident retains an existing verified/failed
+    verdict. New incidents always start pending even if the previous check
+    was verified. Only a future separately approved verifier can change
+    pending to verified/failed, after matching the incident identity.
+    """
+    path = get_integrity_verification_path(home)
+    incident_id = _integrity_incident_id(evidence)
+    if path.exists():
+        previous = _read_json(path)
+        if not previous or previous.get("schema_version") != 1:
+            raise ValueError("invalid-existing-integrity-record")
+        prior_status = previous.get("status")
+        prior_method = previous.get("verification_method")
+        if prior_status not in {"pending", "unverified", "verified", "failed"}:
+            raise ValueError("invalid-existing-integrity-status")
+        if prior_status in {"verified", "failed"}:
+            # A label, method and date alone are not a completed check.
+            proof = previous.get("verification_evidence")
+            expected_result = "ok" if prior_status == "verified" else "failed"
+            if (prior_method not in {"quick_check", "integrity_check"}
+                    or not previous.get("completed_at")
+                    or not isinstance(proof, dict)
+                    or proof.get("incident_id") != previous.get("incident_id")
+                    or proof.get("method") != prior_method
+                    or proof.get("completed_at") != previous.get("completed_at")
+                    or proof.get("result") != expected_result):
+                raise ValueError("unsubstantiated-integrity-verdict")
+        if previous.get("incident_id") == incident_id:
+            return previous
+    record = {
+        "schema_version": 1,
+        "incident_id": incident_id,
+        "prior_pid": evidence.get("prior_pid"),
+        "prior_started_at": evidence.get("prior_started_at"),
+        "detected_at": datetime.now(timezone.utc).isoformat(),
+        "status": "pending",
+        "verification_method": "none",
+    }
+    from utils import atomic_json_write
+    atomic_json_write(path, record, indent=2, mode=0o600)
+    return record
+
+
