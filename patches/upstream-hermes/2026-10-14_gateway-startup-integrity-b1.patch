+    assert evidence["state_db_integrity"] == "unverified"
+    assert path.read_text() == "unparseable"
+
+
+def test_zero_db_or_absent_db_does_not_claim_verified(tmp_path):
+    _unclean(tmp_path)
+    (tmp_path / "state.db").write_bytes(b"")
+    ledger.record_startup(home=tmp_path)
+    assert _record(tmp_path)["status"] in ("pending", "unverified")
+    assert _record(tmp_path)["status"] != "verified"
+
+
+def test_integrity_record_has_atomic_helper_and_no_worker_start(tmp_path, monkeypatch):
+    _unclean(tmp_path)
+    seen = []
+    import utils
+    original = utils.atomic_json_write
+    def capture(path, data, **kwargs):
+        seen.append((str(path), kwargs))
+        return original(path, data, **kwargs)
+    monkeypatch.setattr(utils, "atomic_json_write", capture)
+    ledger.record_startup(home=tmp_path)
+    assert any("gateway-integrity-verification.json" in p for p, _ in seen)
+    assert len([p for p, _ in seen if "gateway-integrity-verification.json" in p]) == 1
+
+
+def test_pending_status_is_not_integrity_ok_in_readiness(tmp_path, monkeypatch):
+    _unclean(tmp_path)
+    ledger.record_startup(home=tmp_path)
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    from gateway.readiness import collect_runtime_readiness
+    result = collect_runtime_readiness(
+        configured_model="test/model",
