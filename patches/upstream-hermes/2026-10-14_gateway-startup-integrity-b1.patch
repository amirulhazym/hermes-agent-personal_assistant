+    assert evidence["state_db_integrity"] == "unverified"
+    assert not (tmp_path / "state" / "gateway-integrity-verification.json").exists()
+    assert "integrity" in caplog.text.lower()
+    line = (tmp_path / "logs" / "gateway-exit-diag.log").read_text().splitlines()[-1]
+    assert json.loads(line)["state_db_integrity"] == "unverified"
+
+
+def test_malformed_prior_integrity_file_is_not_overwritten(tmp_path, caplog):
+    _unclean(tmp_path)
