+"""B1: startup must preserve integrity evidence without running a full DB scan.
+
+Fixture-only: never touch production state.db or start a background verifier.
+"""
+import json
+from pathlib import Path
+
+import pytest
+
+import gateway.lifecycle_ledger as ledger
+
+
+OLD_PID = 2 ** 22 + 45678
+
+
+def _unclean(home: Path, *, prior_pid: int = OLD_PID, started: str = "2026-10-14T08:00:00Z"):
+    path = ledger.get_lifecycle_sentinel_path(home)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps({
+        "phase": "running",
+        "pid": prior_pid,
+        "start_time": 12345.0 + prior_pid,
+        "started_at": started,
+    }))
+
+
+def _record(home: Path):
+    return json.loads((home / "state" / "gateway-integrity-verification.json").read_text())
+
+
+def test_unclean_boot_records_pending_without_any_sqlite_scan(tmp_path, monkeypatch):
+    _unclean(tmp_path)
+    def forbidden(*args, **kwargs):
+        raise AssertionError("startup must never invoke explicit DB integrity scan")
+    monkeypatch.setattr(ledger, "check_state_db_integrity", forbidden)
+    monkeypatch.setattr(ledger.sqlite3, "connect", forbidden)
+    evidence = ledger.record_startup(home=tmp_path)
+    status = _record(tmp_path)
+    assert evidence["state_db_integrity"] == "pending"
+    assert status["status"] == "pending"
+    assert status["verification_method"] == "none"
+    assert status["incident_id"] == evidence["integrity_incident_id"]
+    assert status["prior_pid"] == OLD_PID
+    assert (tmp_path / "logs" / "gateway-exit-diag.log").exists()
+    assert ledger._read_json(ledger.get_lifecycle_sentinel_path(tmp_path))["prior_unclean_exit"]
+
+
+def test_clean_boot_does_not_scan_or_invent_incident(tmp_path, monkeypatch):
+    _unclean(tmp_path)
+    ledger.mark_exited(home=tmp_path)  # not owned by this PID; write clean sentinel below
+    path = ledger.get_lifecycle_sentinel_path(tmp_path)
+    path.write_text(json.dumps({"phase": "exited", "pid": OLD_PID}))
+    monkeypatch.setattr(ledger, "check_state_db_integrity",
+                        lambda **kw: (_ for _ in ()).throw(AssertionError("called")))
+    assert ledger.record_startup(home=tmp_path) is None
+    assert not (tmp_path / "state" / "gateway-integrity-verification.json").exists()
+
+
+def test_clean_exit_does_not_erase_pending_record(tmp_path):
+    _unclean(tmp_path)
+    ledger.record_startup(home=tmp_path)
+    before = _record(tmp_path)
+    ledger.mark_exited(home=tmp_path)
+    assert _record(tmp_path) == before
+    assert ledger.record_startup(home=tmp_path) is None
+    assert _record(tmp_path) == before
+
+
+def test_new_unclean_incident_cannot_inherit_verified(tmp_path):
+    _unclean(tmp_path)
+    ledger.record_startup(home=tmp_path)
+    first = _record(tmp_path)
+    path = tmp_path / "state" / "gateway-integrity-verification.json"
+    first.update(status="verified", verification_method="quick_check", completed_at="2026-10-14T09:00:00Z")
+    first["verification_evidence"] = {
+        "incident_id": first["incident_id"], "result": "ok",
+        "method": "quick_check", "completed_at": first["completed_at"],
+    }
+    path.write_text(json.dumps(first))
+    _unclean(tmp_path, prior_pid=OLD_PID+1, started="2026-10-14T10:00:00Z")
+    evidence = ledger.record_startup(home=tmp_path)
+    second = _record(tmp_path)
+    assert second["incident_id"] != first["incident_id"]
+    assert second["status"] == "pending"
+    assert second["verification_method"] == "none"
+    assert evidence["state_db_integrity"] == "pending"
+
+
+def test_same_incident_preserves_verified_result_if_replayed(tmp_path):
+    _unclean(tmp_path)
+    ledger.record_startup(home=tmp_path)
+    path = tmp_path / "state" / "gateway-integrity-verification.json"
+    first = _record(tmp_path)
+    first.update(status="verified", verification_method="integrity_check", completed_at="2026-10-14T09:00:00Z")
+    first["verification_evidence"] = {
+        "incident_id": first["incident_id"], "result": "ok",
+        "method": "integrity_check", "completed_at": first["completed_at"],
+    }
+    path.write_text(json.dumps(first))
+    _unclean(tmp_path)
+    evidence = ledger.record_startup(home=tmp_path)
+    assert evidence["state_db_integrity"] == "verified"
+    assert _record(tmp_path) == first
+
+
