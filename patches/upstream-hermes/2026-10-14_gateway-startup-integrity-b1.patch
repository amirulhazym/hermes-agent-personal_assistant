+    assert result["checks"]["integrity_verification"]["status"] == "degraded"
+    assert result["status"] == "degraded"
+
+
+def test_readiness_does_not_accept_unsubstantiated_verified(tmp_path, monkeypatch):
+    _unclean(tmp_path)
+    ledger.record_startup(home=tmp_path)
+    record_path = tmp_path / "state" / "gateway-integrity-verification.json"
+    data = _record(tmp_path)
+    data["status"] = "verified"  # forged/no method+completion
+    record_path.write_text(json.dumps(data))
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    from gateway.readiness import collect_runtime_readiness
