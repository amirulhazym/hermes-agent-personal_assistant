+def _probe_integrity_verification(home: Path) -> dict[str, Any]:
+    """Read a small diagnostic, never run a DB integrity scan on a health poll.
+
+    An accessible state.db does NOT establish structural integrity.
+    """
+    from gateway.lifecycle_ledger import (
+        _read_json,
+        get_integrity_verification_path,
+        get_lifecycle_sentinel_path,
+    )
+    sentinel = _read_json(get_lifecycle_sentinel_path(home)) or {}
+    path = get_integrity_verification_path(home)
+    expected_incident = sentinel.get("prior_integrity_incident_id")
+    if not path.exists():
+        if sentinel.get("prior_unclean_exit") or expected_incident:
+            return _check("degraded", verification_state="unverified",
+                          verification_method="none", verified=False)
+        return _check("ok", verification_state="not_required",
+                      verification_method="none", verified=False)
+    record = _read_json(path)
+    if not isinstance(record, dict) or record.get("schema_version") != 1:
+        return _check("degraded", verification_state="unverified",
+                      verification_method="none", verified=False)
+    status = record.get("status")
+    method = record.get("verification_method")
+    incident_id = record.get("incident_id")
+    # A stale previous "verified" record cannot attest a new unclean exit.
+    if (expected_incident and expected_incident != incident_id) or (
+            sentinel.get("prior_unclean_exit") and not expected_incident):
+        return _check("degraded", verification_state="unverified",
+                      verification_method="none", verified=False)
+    evidence = record.get("verification_evidence")
+    if (status == "verified"
+            and method in {"quick_check", "integrity_check"}
+            and record.get("completed_at") and incident_id
+            and isinstance(evidence, dict)
+            and evidence.get("incident_id") == incident_id
+            and evidence.get("method") == method
+            and evidence.get("completed_at") == record.get("completed_at")
+            and evidence.get("result") == "ok"):
+        return _check("ok", verification_state="verified",
+                      verification_method=method, verified=True,
+                      incident_id=incident_id)
+    if status in {"pending", "unverified", "failed"} and incident_id:
+        return _check("degraded", verification_state=status,
+                      verification_method=(method if isinstance(method, str)
+                                           else "none"), verified=False,
+                      incident_id=incident_id)
+    return _check("degraded", verification_state="unverified",
+                  verification_method="none", verified=False)
+
+
