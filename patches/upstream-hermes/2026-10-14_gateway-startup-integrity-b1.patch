+        runtime_status={"gateway_state": "running", "platforms": {}},
+    )
+    assert result["checks"]["integrity_verification"]["verification_state"] == "unverified"
+    assert result["checks"]["integrity_verification"]["status"] == "degraded"
+
+
+def test_readiness_treats_missing_status_after_unclean_exit_as_unverified(tmp_path, monkeypatch):
+    _unclean(tmp_path)
+    ledger.record_startup(home=tmp_path)
+    (tmp_path / "state" / "gateway-integrity-verification.json").unlink()
