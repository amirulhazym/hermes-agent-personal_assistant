+from __future__ import annotations
+
+from agent.iteration_continuation import (
+    ContinuationDecision,
+    ProgressSnapshot,
+    ProgressTracker,
+    decide_continuation,
+    fingerprint_tool_call,
+)
+
+
+
+
+def test_tool_fingerprint_is_stable_and_does_not_expose_arguments():
+    first = fingerprint_tool_call("terminal", {"command": "echo secret-value"})
+    second = fingerprint_tool_call("terminal", {"command": "echo secret-value"})
+    other = fingerprint_tool_call("terminal", {"command": "echo other-value"})
+    assert first == second
+    assert first != other
+    assert "secret-value" not in first
+
+
+def test_progressing_window_is_eligible_with_deterministic_idempotency_key():
+    snapshot = ProgressSnapshot(
+        successful_tool_calls=2,
+        call_fingerprints=frozenset({"read:a", "write:b"}),
+        mutated_paths=frozenset({"src/app.py"}),
+    )
+    decision = decide_continuation(
+        enabled=True,
+        max_auto_continues=2,
+        continuation_count=0,
+        turn_id="turn-123",
+        window_index=1,
+        snapshot=snapshot,
+    )
+    assert isinstance(decision, ContinuationDecision)
+    assert decision.decision == "continue"
+    assert decision.reason == "progress_detected"
+    assert decision.idempotency_key == "turn-123:auto_continue:1"
+    assert "file_mutation" in decision.progress_kinds
+
+
+def test_repeated_noop_window_is_denied():
+    snapshot = ProgressSnapshot(
+        successful_tool_calls=4,
+        call_fingerprints=frozenset({"read:same"}),
+        repeated_call_streak=4,
+    )
+    decision = decide_continuation(
+        enabled=True,
+        max_auto_continues=2,
+        continuation_count=0,
+        turn_id="turn-123",
+        window_index=1,
+        snapshot=snapshot,
+    )
+    assert decision.decision == "stop"
+    assert decision.reason == "no_progress"
+
+
+def test_unknown_effect_and_interrupt_are_denied():
+    for snapshot, reason in [
+        (ProgressSnapshot(successful_tool_calls=1, unknown_effect_calls=1), "unknown_effect"),
