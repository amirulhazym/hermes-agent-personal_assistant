+"""Bounded progress-aware continuation policy for main agent turns."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from dataclasses import dataclass, field
+from typing import FrozenSet, Tuple
+
+
+
+
+def fingerprint_tool_call(function_name: str, function_args: object) -> str:
+    """Return a stable secret-free fingerprint for a tool call."""
+    payload = json.dumps(
+        {"name": function_name, "args": function_args},
+        sort_keys=True,
+        default=str,
+        ensure_ascii=False,
+        separators=(",", ":"),
+    ).encode("utf-8", "replace")
+    return hashlib.sha256(payload).hexdigest()
+
+
+@dataclass(frozen=True)
+class ProgressSnapshot:
+    """Secret-free, per-window evidence used by the continuation gate."""
+
+    successful_tool_calls: int = 0
+    call_fingerprints: FrozenSet[str] = field(default_factory=frozenset)
+    mutated_paths: FrozenSet[str] = field(default_factory=frozenset)
+    checkpoint_count: int = 0
+    repeated_call_streak: int = 0
+    unknown_effect_calls: int = 0
+    interrupted: bool = False
+    approval_pending: bool = False
+    provider_failed: bool = False
+    timed_out: bool = False
+
+    @property
+    def progress_kinds(self) -> Tuple[str, ...]:
+        kinds = []
+        if self.mutated_paths:
+            kinds.append("file_mutation")
+        if self.checkpoint_count > 0:
+            kinds.append("checkpoint")
+        if self.successful_tool_calls > 0 and self.call_fingerprints:
+            kinds.append("successful_tool")
+        return tuple(kinds)
+
+    @property
+    def has_forward_progress(self) -> bool:
+        if self.repeated_call_streak > 0:
+            return False
+        if (
+            not self.mutated_paths
+            and self.checkpoint_count == 0
+            and self.successful_tool_calls > len(self.call_fingerprints)
+        ):
+            return False
+        return bool(self.progress_kinds)
+
+
+
+
+class ProgressTracker:
+    """Mutable per-window accumulator fed by the canonical tool-result seam."""
+
+    def __init__(self) -> None:
+        self._successful_tool_calls = 0
+        self._call_fingerprints: set[str] = set()
+        self._mutated_paths: set[str] = set()
+        self._checkpoint_count = 0
+        self._repeated_call_streak = 0
+        self._last_fingerprint: str | None = None
+        self._unknown_effect_calls = 0
+
+    def record_tool(
+        self,
+        fingerprint: str,
+        *,
+        success: bool,
+        effect_disposition: str | None = None,
+        mutated_paths: set[str] | frozenset[str] | None = None,
+    ) -> None:
+        if success:
+            self._successful_tool_calls += 1
+        if effect_disposition == "unknown":
+            self._unknown_effect_calls += 1
+        if fingerprint == self._last_fingerprint:
+            self._repeated_call_streak += 1
+        else:
+            self._repeated_call_streak = 0
+        self._last_fingerprint = fingerprint
+        self._call_fingerprints.add(fingerprint)
+        self._mutated_paths.update(mutated_paths or ())
+
+    def record_checkpoint(self) -> None:
+        self._checkpoint_count += 1
+
+    def snapshot(self) -> ProgressSnapshot:
+        return ProgressSnapshot(
+            successful_tool_calls=self._successful_tool_calls,
+            call_fingerprints=frozenset(self._call_fingerprints),
+            mutated_paths=frozenset(self._mutated_paths),
+            checkpoint_count=self._checkpoint_count,
+            repeated_call_streak=self._repeated_call_streak,
+            unknown_effect_calls=self._unknown_effect_calls,
+        )
+
+@dataclass(frozen=True)
+class ContinuationDecision:
+    decision: str
+    reason: str
+    turn_id: str
+    window_index: int
+    continuation_count: int
+    idempotency_key: str
+    progress_kinds: Tuple[str, ...] = ()
+
+
+def decide_continuation(
+    *,
+    enabled: bool,
+    max_auto_continues: int,
+    continuation_count: int,
+    turn_id: str,
+    window_index: int,
+    snapshot: ProgressSnapshot,
+) -> ContinuationDecision:
+    """Return one deterministic continue/stop decision for a budget boundary."""
+    key = f"{turn_id}:auto_continue:{window_index}"
+
+    def stop(reason: str) -> ContinuationDecision:
+        return ContinuationDecision(
+            decision="stop",
+            reason=reason,
+            turn_id=turn_id,
+            window_index=window_index,
+            continuation_count=continuation_count,
+            idempotency_key=key,
+            progress_kinds=snapshot.progress_kinds,
+        )
+
+    if not enabled:
+        return stop("disabled")
+    if max_auto_continues <= 0 or continuation_count >= max_auto_continues:
+        return stop("max_auto_continues_exhausted")
+    if snapshot.interrupted:
+        return stop("interrupted")
+    if snapshot.approval_pending:
+        return stop("approval_pending")
+    if snapshot.provider_failed:
+        return stop("provider_failed")
+    if snapshot.timed_out:
+        return stop("timeout")
+    if snapshot.unknown_effect_calls:
+        return stop("unknown_effect")
+    if not snapshot.has_forward_progress:
+        return stop("no_progress")
+    return ContinuationDecision(
+        decision="continue",
+        reason="progress_detected",
+        turn_id=turn_id,
+        window_index=window_index,
+        continuation_count=continuation_count,
+        idempotency_key=key,
+        progress_kinds=snapshot.progress_kinds,
+    )
