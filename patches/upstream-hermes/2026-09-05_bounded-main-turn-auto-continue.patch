+from __future__ import annotations
+
+from hermes_cli.config import resolve_auto_continue_config
+from hermes_cli.config_defaults import DEFAULT_CONFIG
+
+
+def test_default_policy_is_disabled_and_bounded():
+    cfg = resolve_auto_continue_config(DEFAULT_CONFIG["agent"])
+    assert cfg == {
+        "enabled": False,
+        "max_auto_continues": 2,
+        "prompt": cfg["prompt"],
+    }
+    assert cfg["prompt"]
+
+
+def test_explicit_policy_preserves_two_window_bound():
+    cfg = resolve_auto_continue_config(
+        {
+            "auto_continue_on_max_iterations": {
+                "enabled": True,
+                "max_auto_continues": 2,
+                "prompt": "Continue from current state.",
+            }
+        }
+    )
+    assert cfg == {
+        "enabled": True,
+        "max_auto_continues": 2,
+        "prompt": "Continue from current state.",
+    }
+
+
+def test_malformed_or_non_positive_bound_falls_back_to_safe_disabled_policy():
+    cfg = resolve_auto_continue_config(
+        {
+            "auto_continue_on_max_iterations": {
+                "enabled": True,
+                "max_auto_continues": 0,
+                "prompt": "unsafe",
+            }
+        }
+    )
+    assert cfg["enabled"] is False
+    assert cfg["max_auto_continues"] == 2
+    assert cfg["prompt"] != "unsafe"
