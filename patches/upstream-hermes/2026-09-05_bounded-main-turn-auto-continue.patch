+"""Gateway entry-point coverage for bounded main-turn auto-continue.
+
+Proves the gateway main-turn path resolves the same opt-in continuation
+policy as the CLI path, refreshes cached agents per turn from the resolved
+config, keeps decision receipts secret-free, and leaves /goal and
+delegation budgets untouched.
+"""
+from __future__ import annotations
+
+from agent.iteration_continuation import (
+    ProgressTracker,
+    decide_continuation,
+    fingerprint_tool_call,
+)
+from hermes_cli.config import resolve_auto_continue_config
+
+
+def _enabled_agent_cfg() -> dict:
+    return {
+        "max_turns": 300,
+        "auto_continue_on_max_iterations": {
+            "enabled": True,
+            "max_auto_continues": 2,
+            "prompt": "Inspect current state before repeating work.",
+        },
+    }
+
+
+def test_gateway_resolves_same_bounded_policy_as_cli():
+    cfg = resolve_auto_continue_config(_enabled_agent_cfg())
+    assert cfg["enabled"] is True
+    assert cfg["max_auto_continues"] == 2
+    assert isinstance(cfg["prompt"], str) and cfg["prompt"].strip()
+
+
+def test_gateway_defaults_to_disabled_without_opt_in():
+    cfg = resolve_auto_continue_config({"max_turns": 100})
+    assert cfg["enabled"] is False
+
+
+def test_gateway_refreshes_cached_agent_policy_per_turn():
+    class _Agent:
+        pass
+
+    agent = _Agent()
+    agent._auto_continue_config = resolve_auto_continue_config({"max_turns": 100})
+    assert agent._auto_continue_config["enabled"] is False
+    # Same per-turn refresh assignment gateway/run.py performs on cached agents.
+    agent._auto_continue_config = resolve_auto_continue_config(_enabled_agent_cfg())
+    assert agent._auto_continue_config["enabled"] is True
+    assert agent._auto_continue_config["max_auto_continues"] == 2
+
+
+def test_gateway_receipt_fields_are_secret_free():
+    raw_args = {"path": "/tmp/x", "content": "SECRET-TOKEN-abc123"}
+    fp = fingerprint_tool_call("write_file", raw_args)
+    assert "SECRET-TOKEN-abc123" not in fp
+    tracker = ProgressTracker()
+    tracker.record_tool(fp, success=True, mutated_paths={"/tmp/x"})
+    decision = decide_continuation(
+        enabled=True,
+        max_auto_continues=2,
+        continuation_count=0,
+        turn_id="gw-turn-1",
+        window_index=1,
+        snapshot=tracker.snapshot(),
+    )
+    assert decision.decision == "continue"
+    assert decision.idempotency_key == "gw-turn-1:auto_continue:1"
+    receipt = {
+        "turn_id": decision.turn_id,
+        "window_index": decision.window_index,
+        "budget_used": 300,
+        "budget_max": 300,
+        "continuation_count": decision.continuation_count,
+        "progress_kinds": list(decision.progress_kinds),
+        "decision": decision.decision,
+        "idempotency_key": decision.idempotency_key,
+        "tool_fingerprint": fp,
+    }
+    assert "SECRET-TOKEN-abc123" not in repr(receipt)
+    assert "file_mutation" in receipt["progress_kinds"]
+
+
+def test_goal_and_delegation_keys_do_not_enable_continuation():
+    cfg = resolve_auto_continue_config(
+        {
+            "max_turns": 100,
+            "goals": {"max_turns": 20},
+            "delegation": {"max_iterations": 250},
+        }
+    )
+    assert cfg["enabled"] is False
