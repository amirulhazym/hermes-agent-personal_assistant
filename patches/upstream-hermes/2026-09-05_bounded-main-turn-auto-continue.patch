+def resolve_auto_continue_config(agent_cfg: Any) -> Dict[str, Any]:
+    """Normalize the bounded main-turn auto-continuation policy.
+
+    The feature is deliberately fail-closed: malformed or non-positive bounds
+    disable the policy and return the safe built-in bound/prompt. This helper
+    only normalizes configuration; it does not decide whether a live turn has
+    made progress.
+    """
+    default = {
+        "enabled": False,
+        "max_auto_continues": 2,
+        "prompt": (
+            "Continue from the current state. Do not repeat completed work. "
+            "Stop if blocked, approval is required, or before destructive "
+            "or externally visible actions."
+        ),
+    }
+    if not isinstance(agent_cfg, dict):
+        return default
+    raw = agent_cfg.get("auto_continue_on_max_iterations")
+    if not isinstance(raw, dict):
+        return default
+    try:
+        bound = int(raw.get("max_auto_continues", default["max_auto_continues"]))
+    except (TypeError, ValueError):
+        return default
+    prompt = raw.get("prompt", default["prompt"])
+    if bound <= 0 or not isinstance(prompt, str) or not prompt.strip():
+        return default
+    enabled = raw.get("enabled", False)
+    if isinstance(enabled, str):
+        enabled = enabled.strip().lower() in {"1", "true", "yes", "on"}
+    elif not isinstance(enabled, bool):
+        enabled = False
+    return {
+        "enabled": enabled,
+        "max_auto_continues": bound,
+        "prompt": prompt.strip(),
+    }
+
