diff --git a/tests/agent/test_auxiliary_antigravity_middleware_20260927.py b/tests/agent/test_auxiliary_antigravity_middleware_20260927.py
new file mode 100644
index 0000000000000000000000000000000000000000..d233b3ca0e6a5071dec218da29fc3a8d39f71734
--- /dev/null
+++ b/tests/agent/test_auxiliary_antigravity_middleware_20260927.py
@@ -0,0 +1,67 @@
+from types import SimpleNamespace
+
+import pytest
+
+from agent import auxiliary_client
+
+
+def test_sync_antigravity_auxiliary_uses_llm_execution_middleware(monkeypatch):
+    observed = []
+    direct_calls = []
+
+    client = SimpleNamespace(
+        chat=SimpleNamespace(
+            completions=SimpleNamespace(
+                create=lambda **kwargs: direct_calls.append(kwargs)
+            )
+        )
+    )
+
+    def _middleware(request, callback, *, provider=None):
+        observed.append((provider, request["model"]))
+        return SimpleNamespace(
+            choices=[SimpleNamespace(message=SimpleNamespace(content="summary"))]
+        )
+
+    monkeypatch.setattr(
+        "hermes_cli.middleware.run_llm_execution_middleware",
+        _middleware,
+    )
+    result = auxiliary_client._relay_sync_completion(
+        client,
+        {"model": "gemini-3.8-flash", "messages": []},
+        provider="antigravity",
+    )
+
+    assert result.choices[0].message.content == "summary"
+    assert observed == [("antigravity", "gemini-3.8-flash")]
+    assert direct_calls == []
+
+
+def test_sync_antigravity_auxiliary_fails_closed_when_middleware_raises(monkeypatch):
+    direct_calls = []
+
+    client = SimpleNamespace(
+        chat=SimpleNamespace(
+            completions=SimpleNamespace(
+                create=lambda **kwargs: direct_calls.append(kwargs)
+            )
+        )
+    )
+
+    def _middleware(_request, _callback, *, provider=None):
+        assert provider == "antigravity"
+        raise RuntimeError("middleware interception failed")
+    monkeypatch.setattr(
+        "hermes_cli.middleware.run_llm_execution_middleware",
+        _middleware,
+    )
+
+    with pytest.raises(RuntimeError, match="middleware interception failed"):
+        auxiliary_client._relay_sync_completion(
+            client,
+            {"model": "gemini-3.8-flash", "messages": []},
+            provider="antigravity",
+        )
+
+    assert direct_calls == []
diff --git a/tests/hermes_cli/test_opencode_free_chat_fail_closed_20260927.py b/tests/hermes_cli/test_opencode_free_chat_fail_closed_20260927.py
new file mode 100644
index 0000000000000000000000000000000000000000..f3fa8704b1cab6dd9631589fd302ecf4f46f2b3a
--- /dev/null
+++ b/tests/hermes_cli/test_opencode_free_chat_fail_closed_20260927.py
@@ -0,0 +1,101 @@
+from __future__ import annotations
+
+import hermes_cli.model_switch as model_switch
+
+
+_BLOCK_TEXT = "only be used from within OpenCode"
+
+
+def _allowed_runtime(**_kwargs):
+    return {
+        "provider": "opencode-free",
+        "api_key": "no-key-required",
+        "base_url": "https://opencode.ai/zen/v1",
+        "api_mode": "chat_completions",
+    }
+
+
+def _accepted_validation(*_args, **_kwargs):
+    return {
+        "accepted": True,
+        "persist": True,
+        "recognized": True,
+        "message": "",
+    }
+
+
+def test_shared_picker_hides_opencode_free_even_if_stale_row_is_injected(monkeypatch):
+    monkeypatch.setattr(
+        model_switch,
+        "list_authenticated_providers",
+        lambda **_kwargs: [
+            {
+                "slug": "opencode-free",
+                "name": "OpenCode Free",
+                "models": ["mimo-v2.6-flash-free"],
+                "total_models": 1,
+                "is_current": True,
+                "is_user_defined": False,
+            },
+            {
+                "slug": "openai-codex",
+                "name": "OpenAI Codex",
+                "models": ["gpt-6-luna"],
+                "total_models": 1,
+                "is_current": False,
+                "is_user_defined": False,
+            },
+        ],
+    )
+
+    rows = model_switch.list_picker_providers(
+        current_provider="opencode-free",
+        current_model="mimo-v2.6-flash-free",
+    )
+    assert [row["slug"] for row in rows] == ["openai-codex"]
+def test_explicit_opencode_free_alias_is_rejected_before_runtime_call(monkeypatch):
+    calls = {"runtime": 0}
+
+    def _runtime(**kwargs):
+        calls["runtime"] += 1
+        return _allowed_runtime(**kwargs)
+
+    monkeypatch.setattr("hermes_cli.runtime_provider.resolve_runtime_provider", _runtime)
+    monkeypatch.setattr("hermes_cli.models.validate_requested_model", _accepted_validation)
+
+    result = model_switch.switch_model(
+        "mimo-v2.6-flash-free",
+        current_provider="openai-codex",
+        current_model="gpt-6-luna",
+        explicit_provider="free",
+    )
+
+    assert result.success is False
+    assert result.target_provider == "opencode-free"
+    assert _BLOCK_TEXT.lower() in result.error_message.lower()
+    assert calls["runtime"] == 0
+
+def test_model_only_detection_cannot_route_into_opencode_free(monkeypatch):
+    calls = {"runtime": 0}
+
+    def _runtime(**kwargs):
+        calls["runtime"] += 1
+        return _allowed_runtime(**kwargs)
+
+    monkeypatch.setattr(
+        "hermes_cli.models.detect_provider_for_model",
+        lambda _model, _current: ("opencode-free", "mimo-v2.6-flash-free"),
+    )
+    monkeypatch.setattr("hermes_cli.runtime_provider.resolve_runtime_provider", _runtime)
+    monkeypatch.setattr("hermes_cli.models.validate_requested_model", _accepted_validation)
+
+    result = model_switch.switch_model(
+        "mimo-v2.6-flash-free",
+        current_provider="openai-codex",
+        current_model="gpt-6-luna",
+    )
+
+    assert result.success is False
+    assert result.target_provider == "opencode-free"
+    assert _BLOCK_TEXT.lower() in result.error_message.lower()
+    assert calls["runtime"] == 0
