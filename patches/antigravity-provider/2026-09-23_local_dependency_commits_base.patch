+from __future__ import annotations
+
+from typing import Any
+
+from .models import logical_model_id
+
+
+def logical_model_ids_from_catalog(payload: dict[str, Any]) -> list[str]:
+    """Return deduplicated Hermes model IDs from fetchAvailableModels output."""
+    models = payload.get("models") if isinstance(payload, dict) else None
+    if not isinstance(models, dict):
+        return []
+
+    result: list[str] = []
+    seen: set[str] = set()
+    for wire_id in models:
+        if not isinstance(wire_id, str):
+            continue
+        logical = logical_model_id(wire_id)
+        if logical and logical not in seen:
+            seen.add(logical)
+            result.append(logical)
+    return result
