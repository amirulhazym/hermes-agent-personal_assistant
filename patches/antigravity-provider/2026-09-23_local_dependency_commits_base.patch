+def logical_model_id(model: str) -> str | None:
+    """Convert an Antigravity wire/catalog ID to a picker-facing model ID.
+
+    ``fetchAvailableModels`` returns route variants (for example
+    ``gemini-3.7-flash-tiered``), while Hermes should expose one stable logical
+    model choice (``google-antigravity/gemini-3.7-flash``). Internal tab/chat
+    and image-only entries are excluded from the chat picker.
+    """
+    bare = strip_provider_prefix(model)
+    if not bare or bare.startswith(("chat_", "tab_")) or "image" in bare:
+        return None
+    bare = WIRE_TO_LOGICAL.get(bare, bare)
+    flash = re.fullmatch(
+        r"(gemini-\d+(?:\.\d+)?-flash)(?:-(?:extra-low|low|medium|high|tiered|thinking|agent))?",
+        bare,
+    )
+    pro = re.fullmatch(
+        r"(gemini-\d+(?:\.\d+)?-pro)(?:-(?:low|medium|high|thinking|agent))?",
+        bare,
+    )
+    claude = re.fullmatch(
+        r"(claude-(?:sonnet|opus)-\d+-\d+)(?:-thinking)?",
+        bare,
+    )
+    if flash:
+        bare = flash.group(1)
+    elif pro:
+        bare = pro.group(1)
+    elif claude:
+        bare = claude.group(1)
+    elif bare.startswith("gpt-oss-"):
+        bare = WIRE_TO_LOGICAL.get(bare, bare)
+    if not bare.startswith(("gemini-", "claude-")) and not bare.startswith("gpt-oss-"):
+        return None
+    return bare
+
 
 
