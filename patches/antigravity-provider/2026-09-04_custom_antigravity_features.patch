+def fetch_available_models(
+    *,
+    client: Any | None = None,
+    store: Any | None = None,
+) -> dict[str, Any]:
+    """Fetch the live model entitlement catalog, refreshing OAuth once if needed."""
+    if client is None:
+        client = AntigravityClient()
+    if store is None:
+        store = CredentialStore.default()
+    creds = load_antigravity_credentials(store)
+    try:
+        return client.fetch_available_models(
+            access_token=creds["access_token"],
+            project_id=creds["project_id"],
+        )
+    except TokenExpired:
+        if not creds.get("refresh_token"):
+            raise
+        refreshed = refresh_access_token(creds["refresh_token"])
+        if creds.get("source") == "store":
+            saved = store.load()
+            saved.update(refreshed)
+            store.save(saved)
+        return client.fetch_available_models(
+            access_token=refreshed["access_token"],
+            project_id=creds["project_id"],
+        )
