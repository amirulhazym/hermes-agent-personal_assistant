+import unittest
+
+from antigravity_provider.catalog import logical_model_ids_from_catalog
+
+
+class LiveCatalogTests(unittest.TestCase):
+    def test_maps_wire_variants_and_deduplicates_families(self):
+        payload = {
+            "models": {
+                "gemini-3.7-flash-tiered": {},
+                "gemini-3.6-flash-low": {},
+                "gemini-3.6-flash-high": {},
+                "claude-opus-4-6-thinking": {},
+                "chat_23310": {},
+                "tab_flash_lite_preview": {},
+                "gemini-3.1-flash-image": {},
+            }
+        }
+        self.assertEqual(
+            logical_model_ids_from_catalog(payload),
+            [
+                "gemini-3.7-flash",
+                "gemini-3.6-flash",
+                "claude-opus-4-6",
+            ],
+        )
+
+    def test_invalid_catalog_is_empty(self):
+        self.assertEqual(logical_model_ids_from_catalog({}), [])
+        self.assertEqual(logical_model_ids_from_catalog({"models": []}), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
